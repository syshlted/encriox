+data class SealedDatabaseRepair (
+    var `tables`: kotlin.UInt
+    , 
+    var `rows`: kotlin.ULong
+    , 
+    var `unreadablePages`: kotlin.ULong
+    , 
+    var `danglingRows`: kotlin.ULong
+    
+){
+    
+
+    
+
+    
+    companion object
+}
+
+/**
+ * @suppress
+ */
+public object FfiConverterTypeSealedDatabaseRepair: FfiConverterRustBuffer<SealedDatabaseRepair> {
+    override fun read(buf: ByteBuffer): SealedDatabaseRepair {
+        return SealedDatabaseRepair(
+            FfiConverterUInt.read(buf),
+            FfiConverterULong.read(buf),
+            FfiConverterULong.read(buf),
+            FfiConverterULong.read(buf),
+        )
+    }
+
+    override fun allocationSize(value: SealedDatabaseRepair) = (
+            FfiConverterUInt.allocationSize(value.`tables`) +
+            FfiConverterULong.allocationSize(value.`rows`) +
+            FfiConverterULong.allocationSize(value.`unreadablePages`) +
+            FfiConverterULong.allocationSize(value.`danglingRows`)
+    )
+
+    override fun write(value: SealedDatabaseRepair, buf: ByteBuffer) {
+            FfiConverterUInt.write(value.`tables`, buf)
+            FfiConverterULong.write(value.`rows`, buf)
+            FfiConverterULong.write(value.`unreadablePages`, buf)
+            FfiConverterULong.write(value.`danglingRows`, buf)
+    }
+}
