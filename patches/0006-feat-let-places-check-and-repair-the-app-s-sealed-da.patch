+/// What [`sealed_database_check`] finds of a sealed database: sql-support's [`sql_support::obfsvfs::State`].
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum SealedDatabaseState {
+    Missing,
+    Opens,
+    WrongKey,
+    Damaged,
+    InTheClear,
+}
+
+/// What [`sealed_database_repair`] copied: sql-support's [`sql_support::obfsvfs::Repaired`].
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct SealedDatabaseRepair {
+    pub tables: u32,
+    pub rows: u64,
+    pub unreadable_pages: u64,
+    pub dangling_rows: u64,
+}
+
+/// Whether the sealed database at `db_path`, places' or any other an app seals through sql-support's obfsvfs, opens
+/// under `key`, read through, before its component opens it.
+#[handle_error(crate::Error)]
+pub fn sealed_database_check(db_path: impl AsRef<Path>, mut key: Vec<u8>) -> ApiResult<SealedDatabaseState> {
+    let state = normalize_database_path(db_path).map(|path| sql_support::obfsvfs::check(&path, &key));
+    key.fill(0);
+    use sql_support::obfsvfs::State;
+    Ok(match state?? {
+        State::Missing => SealedDatabaseState::Missing,
+        State::Opens => SealedDatabaseState::Opens,
+        State::WrongKey => SealedDatabaseState::WrongKey,
+        State::Damaged => SealedDatabaseState::Damaged,
+        State::InTheClear => SealedDatabaseState::InTheClear,
+    })
+}
+
+/// Copies what SQLite's recovery can read of the damaged sealed database at `db_path` into a new one sealed under the
+/// same `key`, which takes its place: sql-support's [`sql_support::obfsvfs::repair`].
+#[handle_error(crate::Error)]
+pub fn sealed_database_repair(db_path: impl AsRef<Path>, mut key: Vec<u8>) -> ApiResult<SealedDatabaseRepair> {
+    let repaired = normalize_database_path(db_path).map(|path| sql_support::obfsvfs::repair(&path, &key));
+    key.fill(0);
+    let repaired = repaired??;
+    Ok(SealedDatabaseRepair {
+        tables: repaired.tables,
+        rows: repaired.rows,
+        unreadable_pages: repaired.unreadable_pages,
+        dangling_rows: repaired.dangling_rows,
+    })
+}
+
