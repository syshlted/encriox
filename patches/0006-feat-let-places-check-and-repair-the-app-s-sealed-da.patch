+
+    // Whether the sealed database at `db_path` opens under `key`, read through, before its component opens it:
+    // places', or any other an app seals through sql-support's obfsvfs, the logins' and autofill's too. It changes
+    // nothing but the log's index. For an app that asks its user about a database that does not open (encri-firefox,
+    // W22).
+    [Throws=PlacesApiError]
+    SealedDatabaseState sealed_database_check(string db_path, bytes key);
+
+    // Copies what SQLite's recovery can still read of the damaged sealed database at `db_path` into a new one sealed
+    // under the same `key`, which takes its place; what did not read is lost. Refused under a key that is not the
+    // database's, and where nothing could be read, each leaving the database as it was.
+    [Throws=PlacesApiError]
+    SealedDatabaseRepair sealed_database_repair(string db_path, bytes key);
+};
+
+// What sealed_database_check finds.
+enum SealedDatabaseState {
+    "Missing",    // There is none, or its file is empty: its component makes it.
+    "Opens",      // It opens under its key, and SQLite finds it whole.
+    "WrongKey",   // It is sealed under another key: refused, and left as it is.
+    "Damaged",    // Under its own key, a page of it or of its log does not open, or SQLite finds it malformed.
+    "InTheClear", // It is in the clear, which a sealed open refuses.
+};
+
+// What sealed_database_repair copied into the database that took the damaged one's place.
+dictionary SealedDatabaseRepair {
+    u32 tables;           // Its tables, but SQLite's own.
+    u64 rows;             // Their rows.
+    u64 unreadable_pages; // The damaged database's pages that did not open, which the recovery read as holding nothing.
+    u64 dangling_rows;    // The rows read that referred to a row lost with those pages, a visit without its page, dropped.
 };
 
 enum ConnectionType {
