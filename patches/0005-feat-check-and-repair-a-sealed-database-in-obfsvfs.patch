+#[cfg(test)]
+mod test {
+    use super::*;
+    use crate::obfsvfs::{sealed_name, KEY_BYTES, PAGE_SIZE};
+
+    const KEY: [u8; KEY_BYTES] = [7; KEY_BYTES];
+    const OTHER_KEY: [u8; KEY_BYTES] = [9; KEY_BYTES];
+    const MARKER: &str = "ENCRIOXREPAIR0123456789abcdef";
+
+    fn open(path: &Path, key: &[u8]) -> rusqlite::Result<Connection> {
+        let conn = Connection::open_with_flags(sealed_name(path, key).unwrap(), flags() | OpenFlags::SQLITE_OPEN_CREATE)?;
+        conn.execute_batch("PRAGMA journal_mode = WAL; PRAGMA wal_autocheckpoint = 0;")?;
+        Ok(conn)
+    }
+
+    fn insert(conn: &Connection, from: usize, rows: usize) {
+        let tx = conn.unchecked_transaction().unwrap();
+        for i in from..from + rows {
+            tx.execute("INSERT INTO t (id, v) VALUES (?, ?)", (i as i64 + 1, format!("{MARKER}-{i}-{}", "x".repeat(i % 200))))
+                .unwrap();
+        }
+        tx.commit().unwrap();
+    }
+
+    /// A sealed database in `dir` of `rows` rows in its file and `logged` more in its log, with an index over them,
+    /// as a new process finds it: copied, with its log, while the connection that wrote it is still open.
+    fn made(rows: usize, logged: usize) -> (tempfile::TempDir, PathBuf) {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("places.sqlite");
+        let conn = open(&path, &KEY).unwrap();
+        conn.execute_batch("CREATE TABLE t (id INTEGER PRIMARY KEY, v TEXT); CREATE INDEX t_v ON t (v);").unwrap();
+        insert(&conn, 0, rows);
+        conn.execute_batch("PRAGMA wal_checkpoint(TRUNCATE)").unwrap();
+        insert(&conn, rows, logged);
+        let copy = tempfile::tempdir().unwrap();
+        for name in ["places.sqlite", "places.sqlite-wal"] {
+            std::fs::copy(dir.path().join(name), copy.path().join(name)).unwrap();
+        }
+        let path = copy.path().join("places.sqlite");
+        (copy, path)
+    }
+
+    /// The rows the table's leaves hold, each page by its number, as SQLite's dbstat has them.
+    fn leaves(path: &Path) -> Vec<(i64, i64)> {
+        let conn = open(path, &KEY).unwrap();
+        conn.set_db_config(DbConfig::SQLITE_DBCONFIG_NO_CKPT_ON_CLOSE, true).unwrap();
+        let mut stmt = conn
+            .prepare("SELECT pageno, ncell FROM dbstat WHERE name = 't' AND pagetype = 'leaf' ORDER BY pageno")
+            .unwrap();
+        let found = stmt.query_map([], |r| Ok((r.get(0)?, r.get(1)?))).unwrap();
+        found.collect::<rusqlite::Result<_>>().unwrap()
+    }
+
+    /// Page `page` of the database's file changed, as damage changes it: its tag no longer holds.
+    fn damage(path: &Path, page: i64) {
+        let mut bytes = std::fs::read(path).unwrap();
+        let start = (page as usize - 1) * PAGE_SIZE;
+        for b in &mut bytes[start + 1000..start + 1016] {
+            *b ^= 0xff;
+        }
+        std::fs::write(path, bytes).unwrap();
+    }
+
+    fn rows(path: &Path) -> rusqlite::Result<i64> {
+        open(path, &KEY)?.query_row("SELECT count(*) FROM t WHERE v LIKE ?", [format!("{MARKER}%")], |r| r.get(0))
+    }
+
+    /// The directory's files and what each holds, but the log's index, which any open may make again.
+    fn files(dir: &Path) -> Vec<(String, Vec<u8>)> {
+        let mut found: Vec<_> = std::fs::read_dir(dir)
+            .unwrap()
+            .map(|e| e.unwrap().path())
+            .filter(|p| !p.to_string_lossy().ends_with("-shm"))
+            .map(|p| (p.file_name().unwrap().to_string_lossy().into_owned(), std::fs::read(&p).unwrap()))
+            .collect();
+        found.sort();
+        found
+    }
+
+    #[test]
+    fn test_check_tells_each_state_and_changes_nothing() {
+        let dir = tempfile::tempdir().unwrap();
+        assert_eq!(check(&dir.path().join("none.sqlite"), &KEY).unwrap(), State::Missing);
+        std::fs::write(dir.path().join("empty.sqlite"), b"").unwrap();
+        assert_eq!(check(&dir.path().join("empty.sqlite"), &KEY).unwrap(), State::Missing);
+        let clear = dir.path().join("clear.sqlite");
+        Connection::open(&clear).unwrap().execute_batch("CREATE TABLE t (v)").unwrap();
+        assert_eq!(check(&clear, &KEY).unwrap(), State::InTheClear);
+
+        let (copy, path) = made(500, 100);
+        let before = files(copy.path());
+        assert_eq!(check(&path, &KEY).unwrap(), State::Opens);
+        assert_eq!(files(copy.path()), before, "the check changed a file: its log was checkpointed");
+        assert_eq!(check(&path, &OTHER_KEY).unwrap(), State::WrongKey);
+        assert_eq!(files(copy.path()), before, "a check under another key changed a file");
+        // A page whose newest copy is the database's, not the log's.
+        damage(&path, leaves(&path)[0].0);
+        assert_eq!(check(&path, &KEY).unwrap(), State::Damaged);
+    }
+
+    #[test]
+    fn test_check_finds_a_damaged_page_an_open_does_not_read() {
+        let (_copy, path) = made(2000, 0);
+        let leaves = leaves(&path);
+        damage(&path, leaves[leaves.len() / 2].0);
+        let conn = open(&path, &KEY).unwrap();
+        conn.query_row("SELECT count(*) FROM sqlite_schema", [], |r| r.get::<_, i64>(0)).unwrap();
+        drop(conn);
+        assert_eq!(check(&path, &KEY).unwrap(), State::Damaged);
+    }
+
+    #[test]
+    fn test_repair_copies_every_row_but_the_damaged_page_s() {
+        let (copy, path) = made(2000, 0);
+        let leaves = leaves(&path);
+        let (page, lost) = leaves[leaves.len() / 2];
+        damage(&path, page);
+        let repaired = repair(&path, &KEY).unwrap();
+        assert_eq!(
+            repaired,
+            Repaired { tables: 1, rows: 2000 - lost as u64, unreadable_pages: 1, dangling_rows: 0 }
+        );
+        let names: Vec<_> = files(copy.path()).into_iter().map(|(name, _)| name).collect();
+        assert_eq!(names, ["places.sqlite"], "the damaged database's files are not all gone");
+        for (name, bytes) in files(copy.path()) {
+            assert!(!bytes.windows(MARKER.len()).any(|w| w == MARKER.as_bytes()), "{name} holds a row in the clear");
+        }
+        assert_eq!(rows(&path).unwrap(), 2000 - lost);
+        assert_eq!(check(&path, &KEY).unwrap(), State::Opens);
+        // Its index, made again from the rows.
+        let conn = open(&path, &KEY).unwrap();
+        let indexed: i64 = conn.query_row("SELECT count(*) FROM t INDEXED BY t_v WHERE v > ''", [], |r| r.get(0)).unwrap();
+        assert_eq!(indexed, 2000 - lost);
+    }
+
+    #[test]
+    fn test_repair_keeps_what_the_log_holds() {
+        let (_copy, path) = made(2000, 300);
+        let (page, lost) = leaves(&path)[1];
+        damage(&path, page);
+        let repaired = repair(&path, &KEY).unwrap();
+        assert_eq!(repaired.rows, 2300 - lost as u64);
+        assert_eq!(rows(&path).unwrap(), 2300 - lost);
+    }
+
+    #[test]
+    fn test_repair_reads_past_a_frame_a_crash_tore() {
+        let (_copy, path) = made(2000, 300);
+        let (page, lost) = leaves(&path)[1];
+        // The log's first frame, its page's second half zeros, as a write cut short leaves it: the log ends before
+        // it, and the 300 rows with it. No frame before it shows the key to be the log's, so its database must.
+        let log = sibling(&path, "-wal");
+        let mut bytes = std::fs::read(&log).unwrap();
+        let first = 32 + 24;
+        bytes[first + PAGE_SIZE / 2..first + PAGE_SIZE].fill(0);
+        std::fs::write(&log, bytes).unwrap();
+        damage(&path, page);
+        let repaired = repair(&path, &KEY).unwrap();
+        assert_eq!(repaired.rows, 2000 - lost as u64);
+        assert_eq!(rows(&path).unwrap(), 2000 - lost);
+    }
+
+    #[test]
+    fn test_repair_drops_the_rows_whose_referent_was_lost_and_keeps_the_rest() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("places.sqlite");
+        {
+            let conn = open(&path, &KEY).unwrap();
+            // As places' own: visits refer to their pages, with foreign keys on, as this SQLite has them by default.
+            conn.execute_batch(
+                "CREATE TABLE p (id INTEGER PRIMARY KEY, v TEXT);
+                 CREATE TABLE c (id INTEGER PRIMARY KEY, p INTEGER NOT NULL REFERENCES p(id) ON DELETE CASCADE);",
+            )
+            .unwrap();
+            let tx = conn.unchecked_transaction().unwrap();
+            for i in 1..=2000i64 {
+                tx.execute("INSERT INTO p (id, v) VALUES (?, ?)", (i, format!("{MARKER}-{i}-{}", "x".repeat(200))))
+                    .unwrap();
+                tx.execute("INSERT INTO c (p) VALUES (?)", [i]).unwrap();
+            }
+            tx.commit().unwrap();
+        }
+        let conn = open(&path, &KEY).unwrap();
+        conn.set_db_config(DbConfig::SQLITE_DBCONFIG_NO_CKPT_ON_CLOSE, true).unwrap();
+        let (page, lost): (i64, i64) = conn
+            .query_row(
+                "SELECT pageno, ncell FROM dbstat WHERE name = 'p' AND pagetype = 'leaf' ORDER BY pageno LIMIT 1 OFFSET 3",
+                [],
+                |r| Ok((r.get(0)?, r.get(1)?)),
+            )
+            .unwrap();
+        drop(conn);
+        damage(&path, page);
+        let repaired = repair(&path, &KEY).unwrap();
+        assert_eq!(repaired.dangling_rows, lost as u64);
+        assert_eq!(repaired.rows, 2 * (2000 - lost as u64));
+        let conn = open(&path, &KEY).unwrap();
+        let broken: i64 = conn.query_row("SELECT count(*) FROM pragma_foreign_key_check", [], |r| r.get(0)).unwrap();
+        assert_eq!(broken, 0);
+    }
+
+    #[test]
+    fn test_repair_under_another_key_is_refused_and_changes_nothing() {
+        let (copy, path) = made(500, 100);
+        damage(&path, leaves(&path)[0].0);
+        let before = files(copy.path());
+        assert!(matches!(repair(&path, &OTHER_KEY), Err(Error::WrongKey)));
