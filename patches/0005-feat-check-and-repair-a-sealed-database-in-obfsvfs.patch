+
+//! Whether a sealed database opens, and the repair of one that is damaged, for an app that asks its user what to do
+//! with a database that does not open: encriox, whose history, bookmarks, logins and cards are sealed
+//! (encriox W22).
+//!
+//! - [`check`] opens the database as its component would, and reads it through: its header, its schema, and every
+//!   page SQLite's quick check reads, each the newest of its copies, the log's or the database's. A key not the
+//!   database's is told from damage by the check of its key each page carries ([`crate::obfsvfs`]).
+//! - [`repair`] copies what SQLite's recovery can read of a damaged database (`src/recover/`) into a new one sealed
+//!   under the same key, which takes its place. A page that does not open under its key reads to the recovery as one
+//!   that holds nothing, and is counted; what it held is lost.
+
+use crate::obfsvfs::{self, Error, OnDisk};
+use crate::warn;
+use rusqlite::config::DbConfig;
+use rusqlite::{ffi, Connection, OpenFlags};
+use std::ffi::{c_char, c_int, c_void, CStr, CString};
+use std::os::unix::ffi::OsStrExt;
+use std::path::{Path, PathBuf};
+
+/// What [`check`] finds of a sealed database.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum State {
+    /// There is none, or its file is empty: its component makes it.
+    Missing,
+    /// It opens under its key, and SQLite finds it whole.
+    Opens,
+    /// It is sealed under another key: refused, and left as it is.
+    WrongKey,
+    /// Under its own key, a page of it or of its log does not open, or SQLite finds it malformed.
+    Damaged,
+    /// It is in the clear, which a sealed open refuses.
+    InTheClear,
+}
+
+/// What [`repair`] copied into the database that took the damaged one's place.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Repaired {
+    /// Its tables, but SQLite's own.
+    pub tables: u32,
+    /// Their rows.
+    pub rows: u64,
+    /// The damaged database's pages that did not open, which the recovery read as holding nothing.
+    pub unreadable_pages: u64,
+    /// The rows the recovery read that referred, by a foreign key, to a row lost with those pages, which were dropped:
+    /// a visit without its page, a bookmark without its folder.
+    pub dangling_rows: u64,
+}
+
+/// Whether the sealed database at `path` opens under `key`, read through, before its component opens it. It changes
+/// nothing but its log's index, as any open does: the log is never checkpointed into the database.
+pub fn check(path: &Path, key: &[u8]) -> Result<State, Error> {
+    match std::fs::metadata(path) {
+        // A database whose file is empty is new; SQLite deletes its log at an open, whatever the key.
+        Ok(meta) if meta.len() == 0 => return Ok(State::Missing),
+        Ok(_) => {}
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => return Ok(State::Missing),
+        Err(e) => return Err(Error::Io("read", e)),
+    }
+    if matches!(obfsvfs::on_disk(&c_path(path)?), OnDisk::Clear) {
+        return Ok(State::InTheClear);
+    }
+    let (name, handle) = obfsvfs::sealed_name_with_handle(path, key)?;
+    let read = read_through(&name);
+    obfsvfs::forget(handle);
+    match read {
+        Ok(found) if found == ["ok"] => Ok(State::Opens),
+        Ok(found) => {
+            warn!("obfsvfs: SQLite finds a sealed database malformed, in {} places", found.len());
+            Ok(State::Damaged)
+        }
+        Err(e) => match extended_code(&e) {
+            Some(ffi::SQLITE_AUTH) => Ok(State::WrongKey),
+            Some(code) if is_damage(code) => Ok(State::Damaged),
+            _ => Err(Error::Sqlite("read the database through", e)),
+        },
+    }
+}
+
+/// The database by `name` opened as its component would, without a checkpoint at its close: its schema, then SQLite's
+/// quick check, which reads every page of its tables and indexes.
+fn read_through(name: &Path) -> rusqlite::Result<Vec<String>> {
+    let conn = Connection::open_with_flags(name, flags())?;
+    conn.set_db_config(DbConfig::SQLITE_DBCONFIG_NO_CKPT_ON_CLOSE, true)?;
+    conn.query_row("SELECT count(*) FROM sqlite_schema", [], |row| row.get::<_, i64>(0))?;
+    let mut quick_check = conn.prepare("PRAGMA quick_check")?;
+    let found = quick_check.query_map([], |row| row.get::<_, String>(0))?;
+    found.collect()
+}
+
+/// Copies what SQLite's recovery can read of the damaged sealed database at `path`, under its own `key`, into a new
+/// database sealed under the same key, which then takes its place, its log, its log's index and its journal gone with
+/// it. The damaged database's pages that do not open read to the recovery as holding nothing, and are counted.
+/// Refused under a key that is not the database's, for one in the clear, and where the recovery fails or reads no
+/// table, each leaving the database as it was.
+pub fn repair(path: &Path, key: &[u8]) -> Result<Repaired, Error> {
+    match obfsvfs::on_disk(&c_path(path)?) {
+        OnDisk::Missing => return Err(Error::Missing),
+        OnDisk::Clear => return Err(Error::InTheClear),
+        _ => {}
+    }
+    let repaired = sibling(path, ".repair");
+    remove(&repaired)?;
+    let (input_name, input_handle) = obfsvfs::repair_name(path, key)?;
+    let (output_name, output_handle) = obfsvfs::sealed_name_with_handle(&repaired, key)?;
+    let copied = copy(&input_name, &output_name);
+    let unreadable_pages = obfsvfs::forget(input_handle);
+    obfsvfs::forget(output_handle);
+    let (tables, rows, dangling_rows) = match copied {
+        Ok(copied) => copied,
+        Err(e) => {
+            remove(&repaired)?;
+            return Err(e);
+        }
+    };
+    // The damaged database's log first: SQLite would read its frames into the new database as its own.
+    for suffix in ["-wal", "-shm", "-journal"] {
+        remove_file(&sibling(path, suffix))?;
+    }
+    std::fs::rename(&repaired, path).map_err(|e| Error::Io("moved into place", e))?;
+    if let Some(dir) = path.parent() {
+        if let Err(e) = std::fs::File::open(dir).and_then(|dir| dir.sync_all()) {
+            warn!("obfsvfs: the repaired database's directory could not be synced: {e}");
+        }
+    }
+    Ok(Repaired {
+        tables,
+        rows,
+        unreadable_pages,
+        dangling_rows,
+    })
+}
+
+/// Runs SQLite's recovery from the database by `input_name`, lenient, into a new one by `output_name`, drops the rows
+/// that refer to rows it could not read, then closes both, the new one out of its log: how many tables it holds, how
+/// many rows, and how many were dropped.
+fn copy(input_name: &Path, output_name: &Path) -> Result<(u32, u64, u64), Error> {
+    let input = Connection::open_with_flags(input_name, flags()).map_err(|e| match extended_code(&e) {
+        Some(ffi::SQLITE_AUTH) => Error::WrongKey,
+        _ => Error::Sqlite("open the damaged database", e),
+    })?;
+    input
+        .set_db_config(DbConfig::SQLITE_DBCONFIG_NO_CKPT_ON_CLOSE, true)
+        .map_err(|e| Error::Sqlite("keep the damaged database's log", e))?;
+    // Opens the database's log now, while the database's file is still obfsvfs's own: the recovery wraps the file
+    // as it begins, and a log opened then would not know that the key is its database's. What it reads is no matter.
+    let _ = input.query_row("SELECT count(*) FROM sqlite_schema", [], |row| row.get::<_, i64>(0));
+    let output = Connection::open_with_flags(output_name, flags() | OpenFlags::SQLITE_OPEN_CREATE)
+        .map_err(|e| Error::Sqlite("make the repaired database", e))?;
+    // Foreign keys off for the copy, which writes a table's rows before or after those they refer to: the recovery's
+    // own pragma for it comes inside its transaction, where SQLite ignores it, and this SQLite turns them on.
+    output
+        .execute_batch("PRAGMA foreign_keys = OFF")
+        .map_err(|e| Error::Sqlite("turn the repaired database's foreign keys off", e))?;
+    recover(&input, &output)?;
+    let dangling = drop_dangling(&output).map_err(|e| Error::Sqlite("drop the rows that refer to rows lost", e))?;
+    let (tables, rows) = count(&output).map_err(|e| Error::Sqlite("count what was repaired", e))?;
+    if tables == 0 {
+        return Err(Error::NothingRead);
+    }
+    // Out of its log, so that the database's file holds every page once it is closed.
+    let mode: String = output
+        .query_row("PRAGMA journal_mode = DELETE", [], |row| row.get(0))
+        .map_err(|e| Error::Sqlite("take the repaired database out of its log", e))?;
+    if !mode.eq_ignore_ascii_case("delete") {
+        return Err(Error::Recovery(format!("the repaired database stayed in journal mode {mode}")));
+    }
+    output.close().map_err(|(_, e)| Error::Sqlite("close the repaired database", e))?;
+    drop(input);
+    Ok((tables, rows, dangling))
+}
+
+/// Deletes the rows that refer, by a foreign key, to a row that is not there, as the recovery leaves those whose
+/// referent was in a page it could not read, until none does, or none of those left can be addressed: how many. A row
+/// of a table without rowids cannot be, and is left.
+fn drop_dangling(conn: &Connection) -> rusqlite::Result<u64> {
+    let mut dropped = 0;
+    loop {
+        let mut check = conn.prepare("PRAGMA foreign_key_check")?;
+        let found = check.query_map([], |row| Ok((row.get::<_, String>(0)?, row.get::<_, Option<i64>>(1)?)))?;
+        let found: Vec<_> = found.collect::<rusqlite::Result<_>>()?;
+        let tx = conn.unchecked_transaction()?;
+        let mut deleted = 0;
+        for (table, rowid) in found {
+            if let Some(rowid) = rowid {
+                let quoted = table.replace('"', "\"\"");
+                deleted += tx.execute(&format!("DELETE FROM \"{quoted}\" WHERE rowid = ?"), [rowid])? as u64;
+            }
+        }
+        tx.commit()?;
+        if deleted == 0 {
+            return Ok(dropped);
+        }
+        dropped += deleted;
+    }
+}
+
+/// Its tables, but SQLite's own and virtual ones, and their rows.
+fn count(conn: &Connection) -> rusqlite::Result<(u32, u64)> {
+    let mut names = conn.prepare(
+        "SELECT name FROM sqlite_schema WHERE type = 'table' AND name NOT LIKE 'sqlite\\_%' ESCAPE '\\'
+         AND sql NOT LIKE 'CREATE VIRTUAL%'",
+    )?;
+    let names: Vec<String> = names.query_map([], |row| row.get(0))?.collect::<rusqlite::Result<_>>()?;
+    let mut rows = 0u64;
+    for name in &names {
+        let quoted = name.replace('"', "\"\"");
+        rows += conn.query_row(&format!("SELECT count(*) FROM \"{quoted}\""), [], |row| row.get::<_, i64>(0))? as u64;
+    }
+    Ok((names.len() as u32, rows))
+}
