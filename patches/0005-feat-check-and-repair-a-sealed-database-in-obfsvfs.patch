+    fn test_repair_that_cannot_read_the_schema_leaves_the_database_as_it_was() {
+        let (copy, path) = made(500, 0);
+        damage(&path, 1);
+        let before = files(copy.path());
+        let e = repair(&path, &KEY).unwrap_err();
+        assert!(matches!(e, Error::Recovery(_) | Error::NothingRead), "{e}");
