+#[allow(non_camel_case_types)]
+#[repr(C)]
+struct sqlite3_recover {
+    _opaque: [u8; 0],
+}
+
+const SQLITE_RECOVER_ROWIDS: c_int = 3;
+
+extern "C" {
+    fn sqlite3_recover_init_sql(
+        db: *mut ffi::sqlite3,
+        z_db: *const c_char,
+        x_sql: Option<unsafe extern "C" fn(*mut c_void, *const c_char) -> c_int>,
+        ctx: *mut c_void,
+    ) -> *mut sqlite3_recover;
+    fn sqlite3_recover_config(p: *mut sqlite3_recover, op: c_int, arg: *mut c_void) -> c_int;
+    fn sqlite3_recover_run(p: *mut sqlite3_recover) -> c_int;
+    fn sqlite3_recover_errmsg(p: *mut sqlite3_recover) -> *const c_char;
+    fn sqlite3_recover_finish(p: *mut sqlite3_recover) -> c_int;
+}
+
+/// Where the recovery's statements go: the new database, and the first failure there.
+struct Replay<'a> {
+    output: &'a Connection,
+    failed: Option<rusqlite::Error>,
+}
+
+unsafe extern "C" fn run_statement(ctx: *mut c_void, sql: *const c_char) -> c_int {
+    let replay = &mut *(ctx as *mut Replay<'_>);
+    let Ok(sql) = CStr::from_ptr(sql).to_str() else {
+        return ffi::SQLITE_ERROR;
+    };
+    match std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| replay.output.execute_batch(sql))) {
+        Ok(Ok(())) => ffi::SQLITE_OK,
+        Ok(Err(e)) => {
+            replay.failed.get_or_insert(e);
+            ffi::SQLITE_ERROR
+        }
+        Err(_) => ffi::SQLITE_ERROR,
+    }
+}
+
+/// SQLite's recovery of `input`'s main database, as SQL, which `output` runs: rows keep their ids, which places', the
+/// logins' and autofill's tables refer to each other by. Nothing of `input` is changed.
+fn recover(input: &Connection, output: &Connection) -> Result<(), Error> {
+    let mut replay = Replay { output, failed: None };
+    // SAFETY: the recovery's calls, on the handle of a connection that outlives it; `replay` outlives the handle.
+    let (rc, message) = unsafe {
+        let p = sqlite3_recover_init_sql(
+            input.handle(),
+            c"main".as_ptr(),
+            Some(run_statement),
+            &mut replay as *mut Replay<'_> as *mut c_void,
+        );
+        if p.is_null() {
+            return Err(Error::Recovery("it could not begin".into()));
+        }
+        let mut on: c_int = 1;
+        sqlite3_recover_config(p, SQLITE_RECOVER_ROWIDS, &mut on as *mut c_int as *mut c_void);
+        sqlite3_recover_run(p);
+        let message = sqlite3_recover_errmsg(p);
+        let message = (!message.is_null()).then(|| CStr::from_ptr(message).to_string_lossy().into_owned());
+        (sqlite3_recover_finish(p), message)
+    };
+    if let Some(e) = replay.failed {
+        let _ = output.execute_batch("ROLLBACK");
+        return Err(Error::Sqlite("write what was recovered", e));
+    }
+    if rc != ffi::SQLITE_OK {
+        let _ = output.execute_batch("ROLLBACK");
+        return Err(Error::Recovery(message.unwrap_or_else(|| format!("SQLite's code {rc}"))));
+    }
+    Ok(())
+}
+
+fn flags() -> OpenFlags {
+    OpenFlags::SQLITE_OPEN_URI | OpenFlags::SQLITE_OPEN_READ_WRITE | OpenFlags::SQLITE_OPEN_NO_MUTEX
+}
+
+fn extended_code(e: &rusqlite::Error) -> Option<c_int> {
+    match e {
+        rusqlite::Error::SqliteFailure(failure, _) => Some(failure.extended_code),
+        _ => None,
+    }
+}
+
+/// A page that does not open under the database's own key, or what SQLite finds malformed.
+fn is_damage(code: c_int) -> bool {
+    code == ffi::SQLITE_IOERR_DATA || code & 0xff == ffi::SQLITE_CORRUPT || code & 0xff == ffi::SQLITE_NOTADB
+}
+
+fn c_path(path: &Path) -> Result<CString, Error> {
+    CString::new(path.as_os_str().as_bytes()).map_err(|_| Error::RelativePath(path.to_owned()))
+}
+
+fn sibling(path: &Path, suffix: &str) -> PathBuf {
+    let mut name = path.as_os_str().to_owned();
+    name.push(suffix);
+    PathBuf::from(name)
+}
+
+/// A database's files, gone: it, its log, its log's index and its journal.
+fn remove(path: &Path) -> Result<(), Error> {
+    for suffix in ["-wal", "-shm", "-journal", ""] {
+        remove_file(&sibling(path, suffix))?;
+    }
+    Ok(())
+}
+
+fn remove_file(path: &Path) -> Result<(), Error> {
+    match std::fs::remove_file(path) {
+        Err(e) if e.kind() != std::io::ErrorKind::NotFound => Err(Error::Io("deleted", e)),
+        _ => Ok(()),
+    }
+}
