+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// Compiles SQLite's recovery extension (`src/recover/`) against the SQLite libsqlite3-sys bundles, for obfsvfs's
+// repair of a damaged sealed database.
+
+fn main() {
+    let include = std::env::var("DEP_SQLITE3_INCLUDE").expect("libsqlite3-sys names its sqlite3.h");
+    cc::Build::new()
+        .file("src/recover/sqlite3recover.c")
+        .file("src/recover/dbdata.c")
+        .include(include)
+        .define("SQLITE_THREADSAFE", "1")
+        .warnings(false)
+        .compile("sql_support_sqlite3recover");
+    println!("cargo:rerun-if-changed=src/recover");
+}
diff --git a/third_party/application-services/components/support/sql/src/recover/README.md b/third_party/application-services/components/support/sql/src/recover/README.md
