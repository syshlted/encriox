+++ b/mobile/android/android-components/components/browser/storage-sync/src/main/java/mozilla/components/browser/storage/sync/Connection.kt
@@ -7,6 +7,7 @@ package mozilla.components.browser.storage.sync
 import androidx.annotation.GuardedBy
 import java.io.Closeable
 import java.io.File
+import kotlinx.coroutines.runBlocking
 import mozilla.appservices.places.PlacesApi
 import mozilla.appservices.places.PlacesReaderConnection
 import mozilla.appservices.places.PlacesWriterConnection
@@ -54,19 +55,39 @@ internal object RustPlacesConnection : Connection {
 
     @GuardedBy("this") private var cachedReader: PlacesReaderConnection? = null
 
+    @GuardedBy("this") private var sealed = false
+
     /**
      * Creates a long-lived [PlacesApi] instance, and caches a reader connection. Writer connection is maintained by
      * [PlacesApi] itself, and is created upon its initialization.
      *
      * @param parentDir Location of the parent directory in which database is/will be stored.
+     * @param databaseKey Where the key the database is sealed with comes from, 32 bytes, or null to keep it in the
+     *   clear. The first init opens the database, and waits for the key: never on the main thread, as it may come
+     *   from a vault the user has yet to unlock. Every init after it must agree.
      */
-    fun init(parentDir: File) =
-        synchronized(this) {
-            if (api == null) {
-                api = PlacesApi(File(parentDir, DB_NAME).canonicalPath)
+    fun init(
+        parentDir: File,
+        databaseKey: (suspend () -> ByteArray)? = null,
+    ) = synchronized(this) {
+        if (api == null) {
+            val path = File(parentDir, DB_NAME).canonicalPath
+            api = if (databaseKey == null) {
+                PlacesApi(path)
+            } else {
+                val key = runBlocking { databaseKey() }
+                try {
+                    PlacesApi(path, key)
+                } finally {
+                    key.fill(0)
+                }
             }
-            cachedReader = api!!.openReader()
+            sealed = databaseKey != null
+        } else {
+            check(sealed == (databaseKey != null)) { "places is open already, ${if (sealed) "sealed" else "in the clear"}" }
         }
+        cachedReader = api!!.openReader()
+    }
 
     override fun registerWithSyncManager() {
         val api = safeGetApi()
