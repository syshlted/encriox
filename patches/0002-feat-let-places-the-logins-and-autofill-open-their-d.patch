+// The same, with the database sealed under `db_key`, 32 bytes, through sql-support's obfsvfs.
+pub fn create_sealed_autofill_store_with_static_key_manager(
+    path: String,
+    db_key: Vec<u8>,
+    key: String,
+) -> ApiResult<Arc<Store>> {
+    let encdec: ManagedEncryptorDecryptor =
+        ManagedEncryptorDecryptor::new(Arc::new(StaticKeyManager::new(key)));
+    check_canary_roundtrip(&encdec)?;
+    Ok(Arc::new(Store::new_sealed(path, db_key, Arc::new(encdec))?))
+}
+
