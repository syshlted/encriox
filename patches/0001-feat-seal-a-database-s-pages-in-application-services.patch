+/// What the start of a database's file says it is.
+enum OnDisk {
+    Missing,
+    Unreadable,
+    /// Too short to say, or not SQLite's: a new database, or one that reads as corrupt either way.
+    Unknown,
+    Clear,
+    Sealed,
+}
+
+fn on_disk(path: &CStr) -> OnDisk {
+    let Ok(path) = path.to_str() else {
+        return OnDisk::Unreadable;
+    };
+    let mut file = match std::fs::File::open(path) {
+        Ok(file) => file,
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => return OnDisk::Missing,
+        Err(_) => return OnDisk::Unreadable,
+    };
+    let mut header = [0u8; 24];
+    match file.read_exact(&mut header) {
+        Ok(()) => {}
+        Err(e) if e.kind() == std::io::ErrorKind::UnexpectedEof => return OnDisk::Unknown,
+        Err(_) => return OnDisk::Unreadable,
+    }
+    if !header.starts_with(MAGIC) {
+        return OnDisk::Unknown;
+    }
+    let page_size = match u16::from_be_bytes([header[16], header[17]]) {
+        1 => 65536,
+        n => n as usize,
+    };
+    if page_size == PAGE_SIZE && header[20] as usize == RESERVED_BYTES {
+        OnDisk::Sealed
+    } else {
+        OnDisk::Clear
+    }
+}
+
+/// Whose key a database's pages on disk are sealed under, as its open finds them, before SQLite reads any.
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+enum Verdict {
+    /// Page 1 opens under the key, or a page of the database or of its log carries the key's check.
+    Its,
+    /// None does, and some page carries a check of another key: the wrong key.
+    NotIts,
+    /// No page carries a check, as none did before the checks: a new database, or one sealed before them.
+    Unknown,
+}
+
+/// Reads the database at `path` and its log as they are on disk, for `p`'s key: page 1, then each page's check, the
+/// database's and then the log's, until one is the key's. Under its own key that is page 1 alone; a page 1 damaged,
+/// even through its check, is told by the next.
+unsafe fn judge(p: &mut ObfsFile, path: &CStr) -> Verdict {
+    let Ok(path) = path.to_str() else {
+        return Verdict::Unknown;
+    };
+    let mut other = false;
+    if let Ok(mut file) = std::fs::File::open(path) {
+        let mut first = [0u8; PAGE_SIZE];
+        if file.read_exact(&mut first).is_ok() && first.starts_with(MAGIC) {
+            let opened = open_page(p, &mut first);
+            first.fill(0);
+            if opened {
+                return Verdict::Its;
+            }
+        }
+        match checks(&mut file, 0, PAGE_SIZE as u64, &p.check) {
+            Some(Verdict::Its) => return Verdict::Its,
+            Some(_) => other = true,
+            None => {}
+        }
+    }
+    // The log's frames, which carry the checks where the database's pages do not: one sealed before the checks, and
+    // written since; or one shorter than a page.
+    if let Ok(mut log) = std::fs::File::open(format!("{path}-wal")) {
+        let mut header = [0u8; WAL_HEADER_BYTES as usize];
+        if log.read_exact(&mut header).is_ok()
+            && u32::from_be_bytes([header[0], header[1], header[2], header[3]]) & !1 == WAL_MAGIC
+            && u32::from_be_bytes([header[8], header[9], header[10], header[11]]) as usize == PAGE_SIZE
+        {
+            let first = (WAL_HEADER_BYTES + WAL_FRAME_HEADER_BYTES) as u64;
+            let frame = (WAL_FRAME_HEADER_BYTES + PAGE) as u64;
+            match checks(&mut log, first, frame, &p.check) {
+                Some(Verdict::Its) => return Verdict::Its,
+                Some(_) => other = true,
+                None => {}
+            }
+        }
+    }
+    if other {
+        Verdict::NotIts
+    } else {
+        Verdict::Unknown
+    }
+}
+
+/// The checks of the pages in `file`, the first starting at `first` and each `stride` after the last: Its at the
+/// first that is `check`, NotIts if none is and another is not zero, None if every one is zero, or there are none.
+fn checks(file: &mut std::fs::File, first: u64, stride: u64, check: &[u8; CHECK_BYTES]) -> Option<Verdict> {
+    let mut found = None;
+    let mut at = first + CHECK_START as u64;
+    let mut read = [0u8; CHECK_BYTES];
+    while file.seek(SeekFrom::Start(at)).is_ok() && file.read_exact(&mut read).is_ok() {
+        if read == *check {
+            return Some(Verdict::Its);
+        }
+        if read != [0; CHECK_BYTES] {
+            found = Some(Verdict::NotIts);
+        }
+        at += stride;
+    }
+    found
+}
+
+/// The key a file's name hands over, which a log's and a journal's name carry too: None if it names none, Err if it
+/// names one that [`sealed_name`] was not given.
+unsafe fn key_in(name: *const c_char) -> Option<Result<[u8; KEY_BYTES], ()>> {
+    let value = ffi::sqlite3_uri_parameter(name, c"sealed".as_ptr());
+    if value.is_null() {
+        return None;
+    }
+    let key = CStr::from_ptr(value)
+        .to_str()
+        .ok()
+        .and_then(|handle| handle.parse::<u64>().ok())
+        .and_then(|handle| keys().lock().unwrap_or_else(|e| e.into_inner()).get(&handle).copied());
+    Some(key.ok_or(()))
+}
+
+unsafe extern "C" fn obfs_open(
+    vfs: *mut ffi::sqlite3_vfs,
+    name: *const c_char,
+    file: *mut ffi::sqlite3_file,
+    flags: c_int,
+    out_flags: *mut c_int,
+) -> c_int {
+    let kind = if flags & ffi::SQLITE_OPEN_MAIN_DB != 0 {
+        Kind::Database
+    } else if flags & ffi::SQLITE_OPEN_WAL != 0 {
+        Kind::Log
+    } else if flags & ffi::SQLITE_OPEN_MAIN_JOURNAL != 0 {
+        Kind::Journal
+    } else {
+        return below_vfs_call!(vfs, xOpen, ffi::SQLITE_CANTOPEN, name, file, flags, out_flags);
+    };
+    if name.is_null() {
+        return below_vfs_call!(vfs, xOpen, ffi::SQLITE_CANTOPEN, name, file, flags, out_flags);
+    }
+    let database = if kind == Kind::Database {
+        ptr::null_mut()
+    } else {
+        ffi::sqlite3_database_file_object(name)
+    };
+    let key = match key_in(name) {
+        Some(Ok(key)) => Some(key),
+        Some(Err(())) => {
+            warn!("obfsvfs: a sealed name whose key is not kept here is refused");
+            return ffi::SQLITE_CANTOPEN;
+        }
+        // A log's or a journal's name carries its database's key; its database is asked too.
+        None if is_ours(database) => Some((*(database as *mut ObfsFile)).key),
+        None => None,
+    };
+    if kind == Kind::Database {
+        match (on_disk(CStr::from_ptr(name)), key.is_some()) {
+            (OnDisk::Unreadable, _) => {
+                warn!("obfsvfs: a database whose start cannot be read is refused");
+                return ffi::SQLITE_CANTOPEN;
+            }
+            (OnDisk::Sealed, false) => {
+                warn!("obfsvfs: a sealed database opened without its key is refused");
+                return ffi::SQLITE_CANTOPEN;
+            }
+            (OnDisk::Clear, true) => {
+                warn!("obfsvfs: a database in the clear opened with a key is refused");
+                return ffi::SQLITE_CANTOPEN;
+            }
+            _ => {}
+        }
+    }
+    let Some(mut key) = key else {
+        return below_vfs_call!(vfs, xOpen, ffi::SQLITE_CANTOPEN, name, file, flags, out_flags);
+    };
+    let (Some(cipher), Some(check)) = (Cipher::new(&key), check_of(&key)) else {
+        key.fill(0);
+        warn!("obfsvfs: the cipher could not take the key");
+        return ffi::SQLITE_CANTOPEN;
+    };
+    let p = file as *mut ObfsFile;
+    ptr::write(
+        p,
+        ObfsFile {
+            base: ffi::sqlite3_file { pMethods: &IO_METHODS },
+            kind,
+            cipher: Box::into_raw(Box::new(cipher)),
+            scratch: Box::into_raw(Box::new([0u8; PAGE_SIZE])),
+            partner: ptr::null_mut(),
+            key,
+            check,
+            in_checkpoint: false,
+            // A log or a journal opens once its database has.
+            key_is_its: is_ours(database) && (*(database as *mut ObfsFile)).key_is_its,
+        },
+    );
+    key.fill(0);
+    if kind == Kind::Database {
+        match judge(&mut *p, CStr::from_ptr(name)) {
+            Verdict::NotIts => {
+                warn!("obfsvfs: a sealed database opened under a key that is not its own is refused");
+                unmake(file);
+                return ffi::SQLITE_AUTH;
+            }
+            verdict => (*p).key_is_its = verdict == Verdict::Its,
+        }
+    }
+    let rc = below_vfs_call!(vfs, xOpen, ffi::SQLITE_CANTOPEN, name, below(file), flags, out_flags);
+    if rc != ffi::SQLITE_OK {
+        unmake(file);
+        return rc;
+    }
+    if is_ours(database) {
+        let database = database as *mut ObfsFile;
+        (*p).partner = database;
+        (*database).partner = p;
+    }
+    ffi::SQLITE_OK
+}
+
+/// Frees what [`obfs_open`] made of a file whose open then failed, which SQLite does not close.
+unsafe fn unmake(file: *mut ffi::sqlite3_file) {
+    let p = file as *mut ObfsFile;
+    drop(Box::from_raw((*p).cipher));
+    drop(Box::from_raw((*p).scratch));
+    (*p).key.fill(0);
+    (*file).pMethods = ptr::null();
+}
