+//! A VFS shim that seals a database's pages under a key given with its name, for an app that keeps its databases
+//! sealed: encriox, whose history, bookmarks, logins and cards are sealed with a key from the user's vault
+//! (encriox, `docs/sealed-history.md`).
+//!
+//! It is the scheme of Gecko's obfuscating VFS (`storage/ObfuscatingVFS.cpp`, after SQLite's public-domain obfsvfs
+//! demo), which seals Gecko's own profile databases, brought to application-services' SQLite, with AES-256-GCM from
+//! NSS in place of Gecko's cipher strategy:
+//!
+//! - A database is opened sealed by a `file:` URI that names this VFS and a key [`sealed_name`] was given, by a
+//!   handle: the key itself is never in a name, which SQLite and rusqlite put into the message of an open that
+//!   fails. Its write-ahead log and its journal are sealed under the same key.
+//! - Each page is [`PAGE_SIZE`] bytes, of which the last 32 are reserved: the tag, the nonce, then the key's check, an
+//!   HMAC of a label of its own under the key, which tells nothing of the key. Page 1's first 32 bytes, the start of
+//!   SQLite's header, stay in the clear, so that SQLite can read the page size and the reserved bytes before it reads
+//!   any page. A `PRAGMA page_size` is ignored.
+//! - The check tells a wrong key from a damaged file, which no tag says. A database whose page 1 does not open under
+//!   the key it is opened with, and none of whose pages, nor its log's, carries that key's check, while some carry
+//!   another's, is under another key: its open is refused, `SQLITE_AUTH`, before anything of it is opened or made.
+//! - Under its own key, a page that does not open is damage: an I/O error, `SQLITE_IOERR_DATA`, never a corrupt
+//!   database, which application-services' components delete and make again; and a frame of the log that does not
+//!   open is one a crash tore, or one left from an earlier log, which SQLite's checksum refuses, ending the log there.
+//! - Registered as SQLite's default, it refuses to open a sealed database without a key, and one in the clear with
+//!   a key: either would be read as corrupt, and deleted.
+//! - A checkpoint copies sealed pages from the log into the database as they are.
+//!
+//! Its limits are Gecko's: a database is sealed when it is made and its key never changes; memory-mapped I/O is off;
+//! and only the database, its log and its journal are sealed, so temporary files must stay in memory, as they do on
+//! Android, where SQLite is built with `SQLITE_TEMP_STORE=3`.
+
+use crate::obfsvfs_cipher::{self, Cipher, NONCE_BYTES, TAG_BYTES};
+use crate::warn;
+use rusqlite::ffi;
+use std::ffi::{c_char, c_int, c_void, CStr};
+use std::io::{Read, Seek, SeekFrom};
+use std::path::{Path, PathBuf};
+use std::collections::HashMap;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::{Mutex, OnceLock};
+use std::{mem, ptr, slice};
+use url::Url;
+
+/// The page size of a sealed database.
+pub const PAGE_SIZE: usize = 8192;
+/// The length of a key, in bytes.
+pub const KEY_BYTES: usize = 32;
+
+const NAME: &CStr = c"appservices-obfsvfs";
+const PAGE: c_int = PAGE_SIZE as c_int;
+const RESERVED_BYTES: usize = 32;
+const CLEAR_PREFIX_BYTES: usize = 32;
+const WAL_HEADER_BYTES: c_int = 32;
+const WAL_FRAME_HEADER_BYTES: c_int = 24;
+const MAGIC: &[u8] = b"SQLite format 3\0";
+// The pager reads these 16 bytes of page 1 to see whether another connection changed the database. Bytes 32 to 39
+// are sealed on disk, so they are served from page 1 opened.
+const CHANGE_COUNTER_OFFSET: i64 = 24;
+const CHANGE_COUNTER_BYTES: c_int = 16;
+// A page's reserved bytes: the tag, which the cipher writes after the sealed payload, the nonce, then the key's check.
+const PAYLOAD_END: usize = PAGE_SIZE - RESERVED_BYTES;
+const NONCE_START: usize = PAYLOAD_END + TAG_BYTES;
+const CHECK_START: usize = NONCE_START + NONCE_BYTES;
+const CHECK_BYTES: usize = 4;
+const _: () = assert!(TAG_BYTES + NONCE_BYTES + CHECK_BYTES == RESERVED_BYTES);
+/// What a key's check is a MAC of, under the key, which seals nothing else with it.
+const CHECK_LABEL: &[u8] = b"appservices-obfsvfs key check";
+const WAL_MAGIC: u32 = 0x377f0682;
+
+/// Page 1's header for a file that is still empty, as Gecko's has it: sealed pages, the reserved bytes, WAL mode.
+/// SQLite takes a new database's page size and reserved bytes from it, and they cannot be changed after.
+const EMPTY_HEADER: [u8; 56] = [
+    0x53, 0x51, 0x4c, 0x69, 0x74, 0x65, 0x20, 0x66, 0x6f, 0x72, 0x6d, 0x61, 0x74, 0x20, 0x33, 0x00, // magic
+    0x20, 0x00, // page size, 8192
+    0x02, 0x02, // write and read versions: WAL
+    RESERVED_BYTES as u8,
+    0x40, 0x20, 0x20, // payload fractions
+    0x00, 0x00, 0x00, 0x01, // change counter
+    0x00, 0x00, 0x00, 0x01, // size in pages
+    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+    0x00, 0x00, // from offset 32
+    0x00, 0x00, 0x00, 0x01, // offset 52: the largest root page, auto-vacuum
+];
+
+#[derive(Debug, thiserror::Error)]
+pub enum Error {
+    #[error("A key is {KEY_BYTES} bytes, not {0}")]
+    KeyLength(usize),
+    #[error("obfsvfs could not be registered with SQLite")]
+    NotRegistered,
+    #[error("A sealed database's path must be absolute: {0:?}")]
+    RelativePath(PathBuf),
+}
+
+/// The keys [`sealed_name`] was given, by the handle each name carries in its place. Kept for the process's life,
+/// as the connections opened by each name are.
+fn keys() -> &'static Mutex<HashMap<u64, [u8; KEY_BYTES]>> {
+    static KEYS: OnceLock<Mutex<HashMap<u64, [u8; KEY_BYTES]>>> = OnceLock::new();
+    KEYS.get_or_init(Default::default)
+}
+
+/// The name to open the database at `path` by, sealed under `key`: a `file:` URI naming this VFS and a handle to the
+/// key, which this keeps. Open it with `SQLITE_OPEN_URI`.
+pub fn sealed_name(path: &Path, key: &[u8]) -> Result<PathBuf, Error> {
+    static NEXT: AtomicU64 = AtomicU64::new(1);
+    let key: [u8; KEY_BYTES] = key.try_into().map_err(|_| Error::KeyLength(key.len()))?;
+    // Named in the URI, an unregistered VFS fails the open; a key alone would be ignored, and the database made in
+    // the clear.
+    if !ensure_registered() {
+        return Err(Error::NotRegistered);
+    }
+    let mut url = Url::from_file_path(path).map_err(|_| Error::RelativePath(path.to_owned()))?;
+    let handle = NEXT.fetch_add(1, Ordering::Relaxed);
+    keys().lock().unwrap_or_else(|e| e.into_inner()).insert(handle, key);
+    url.set_query(Some(&format!("vfs={}&sealed={handle}", NAME.to_str().expect("ASCII"))));
+    Ok(PathBuf::from(String::from(url)))
+}
+
+/// On Android, where application-services has a SQLite of its own, registers obfsvfs before a database is opened,
+/// sealed or not, so that its refusals hold for every open: a sealed database opened by a component that was given no
+/// key is refused, rather than read as corrupt and deleted. Elsewhere, it is registered by the first sealed open.
+pub fn register_on_android() {
+    #[cfg(target_os = "android")]
+    ensure_registered();
+}
+
+/// Registers obfsvfs as SQLite's default VFS, over the one that was. Whether it is registered.
+pub fn ensure_registered() -> bool {
+    static REGISTERED: OnceLock<bool> = OnceLock::new();
+    // SAFETY: SQLite's VFS calls, made once; the VFS is leaked, as SQLite keeps it for good.
+    *REGISTERED.get_or_init(|| unsafe { register() })
+}
+
+unsafe fn register() -> bool {
+    if !ffi::sqlite3_vfs_find(NAME.as_ptr()).is_null() {
+        return true;
+    }
+    let below = ffi::sqlite3_vfs_find(ptr::null());
+    if below.is_null() {
+        return false;
+    }
+    let vfs = Box::leak(Box::new(ffi::sqlite3_vfs {
+        iVersion: (*below).iVersion.min(3),
+        szOsFile: (*below).szOsFile + mem::size_of::<ObfsFile>() as c_int,
+        mxPathname: (*below).mxPathname,
+        pNext: ptr::null_mut(),
+        zName: NAME.as_ptr(),
+        pAppData: below as *mut c_void,
+        xOpen: Some(obfs_open),
+        xDelete: Some(obfs_delete),
+        xAccess: Some(obfs_access),
+        xFullPathname: Some(obfs_full_pathname),
+        xDlOpen: Some(obfs_dl_open),
+        xDlError: Some(obfs_dl_error),
+        xDlSym: Some(obfs_dl_sym),
+        xDlClose: Some(obfs_dl_close),
+        xRandomness: Some(obfs_randomness),
+        xSleep: Some(obfs_sleep),
+        xCurrentTime: Some(obfs_current_time),
+        xGetLastError: Some(obfs_get_last_error),
+        xCurrentTimeInt64: Some(obfs_current_time_int64),
+        xSetSystemCall: Some(obfs_set_system_call),
+        xGetSystemCall: Some(obfs_get_system_call),
+        xNextSystemCall: Some(obfs_next_system_call),
+    }));
+    ffi::sqlite3_vfs_register(vfs, 1) == ffi::SQLITE_OK
+}
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Kind {
+    Database,
+    Log,
+    Journal,
+}
+
+/// An open sealed file. SQLite gives each file `szOsFile` bytes, and the file of the VFS below follows this one.
+#[repr(C)]
+struct ObfsFile {
+    base: ffi::sqlite3_file,
+    kind: Kind,
+    cipher: *mut Cipher,
+    /// One page: what is written is sealed into it, and what is read is opened into it.
+    scratch: *mut [u8; PAGE_SIZE],
+    /// The database's log or journal, or the log's or journal's database, while both are open.
+    partner: *mut ObfsFile,
+    key: [u8; KEY_BYTES],
+    /// The key's check, which every page sealed under it carries.
+    check: [u8; CHECK_BYTES],
+    /// In a checkpoint, pages go from the log into the database as they are, sealed.
+    in_checkpoint: bool,
+    /// Whether the key is shown to be the file's own: its database's pages showed it as the database was opened, or a
+    /// page of this file has opened under it. A frame of the log that does not open is then one a crash tore.
+    key_is_its: bool,
+}
+
+/// A key's check: the first bytes of an HMAC-SHA-256 of [`CHECK_LABEL`] under it, with the last bit set, so that no
+/// key's check is zero, as the bytes are in a page sealed before the checks, and in a frame of a log never written.
+fn check_of(key: &[u8; KEY_BYTES]) -> Option<[u8; CHECK_BYTES]> {
+    let mac = obfsvfs_cipher::mac(key, CHECK_LABEL)?;
+    let mut check = [0u8; CHECK_BYTES];
+    check.copy_from_slice(&mac[..CHECK_BYTES]);
+    check[CHECK_BYTES - 1] |= 1;
+    Some(check)
+}
+
+static IO_METHODS: ffi::sqlite3_io_methods = ffi::sqlite3_io_methods {
+    iVersion: 3,
+    xClose: Some(obfs_close),
+    xRead: Some(obfs_read),
+    xWrite: Some(obfs_write),
+    xTruncate: Some(obfs_truncate),
+    xSync: Some(obfs_sync),
+    xFileSize: Some(obfs_file_size),
+    xLock: Some(obfs_lock),
+    xUnlock: Some(obfs_unlock),
+    xCheckReservedLock: Some(obfs_check_reserved_lock),
+    xFileControl: Some(obfs_file_control),
+    xSectorSize: Some(obfs_sector_size),
+    xDeviceCharacteristics: Some(obfs_device_characteristics),
+    xShmMap: Some(obfs_shm_map),
+    xShmLock: Some(obfs_shm_lock),
+    xShmBarrier: Some(obfs_shm_barrier),
+    xShmUnmap: Some(obfs_shm_unmap),
+    xFetch: Some(obfs_fetch),
+    xUnfetch: Some(obfs_unfetch),
+};
+
+unsafe fn below(file: *mut ffi::sqlite3_file) -> *mut ffi::sqlite3_file {
+    (file as *mut ObfsFile).add(1) as *mut ffi::sqlite3_file
+}
+
+unsafe fn below_vfs(vfs: *mut ffi::sqlite3_vfs) -> *mut ffi::sqlite3_vfs {
+    (*vfs).pAppData as *mut ffi::sqlite3_vfs
+}
+
+unsafe fn is_ours(file: *mut ffi::sqlite3_file) -> bool {
+    !file.is_null() && ptr::eq((*file).pMethods, &IO_METHODS)
+}
+
+// A method of the file below, or `$missing` where it has none.
+macro_rules! below_call {
+    ($file:expr, $method:ident, $missing:expr $(, $arg:expr)*) => {{
+        let file = below($file);
+        match (*(*file).pMethods).$method {
+            Some(method) => method(file $(, $arg)*),
+            None => $missing,
+        }
+    }};
+}
+
+// A method of the VFS below, or `$missing` where it has none.
+macro_rules! below_vfs_call {
+    ($vfs:expr, $method:ident, $missing:expr $(, $arg:expr)*) => {{
+        let vfs = below_vfs($vfs);
+        match (*vfs).$method {
+            Some(method) => method(vfs $(, $arg)*),
+            None => $missing,
+        }
+    }};
+}
+
+/// Seals a page into the file's scratch page. None if it cannot be sealed.
+unsafe fn seal_page(p: &mut ObfsFile, page: &[u8]) -> Option<*const u8> {
+    let out = &mut *p.scratch;
+    let start = if page.starts_with(MAGIC) {
+        if page[20] as usize != RESERVED_BYTES {
+            warn!("obfsvfs: a sealed database's pages must reserve {RESERVED_BYTES} bytes");
+            return None;
+        }
+        out[..CLEAR_PREFIX_BYTES].copy_from_slice(&page[..CLEAR_PREFIX_BYTES]);
+        CLEAR_PREFIX_BYTES
+    } else {
+        0
+    };
+    let mut nonce = [0u8; NONCE_BYTES];
+    if !Cipher::random(&mut nonce)
+        || !(*p.cipher).seal(&nonce, &page[start..PAYLOAD_END], &mut out[start..NONCE_START])
+    {
+        return None;
+    }
+    out[NONCE_START..CHECK_START].copy_from_slice(&nonce);
+    out[CHECK_START..].copy_from_slice(&p.check);
+    Some(out.as_ptr())
+}
+
+/// Opens a sealed page in place. False if it does not open under the file's key, which leaves it as it was.
+unsafe fn open_page(p: &mut ObfsFile, page: &mut [u8]) -> bool {
+    let start = if page.starts_with(MAGIC) { CLEAR_PREFIX_BYTES } else { 0 };
+    let mut nonce = [0u8; NONCE_BYTES];
+    nonce.copy_from_slice(&page[NONCE_START..NONCE_START + NONCE_BYTES]);
+    let out = &mut *p.scratch;
+    let opened = (*p.cipher).open(&nonce, &page[start..NONCE_START], &mut out[start..]);
+    if opened {
+        page[start..PAYLOAD_END].copy_from_slice(&out[start..PAYLOAD_END]);
+        page[PAYLOAD_END..].fill(0);
+    }
+    out.fill(0);
+    opened
+}
+
+unsafe extern "C" fn obfs_close(file: *mut ffi::sqlite3_file) -> c_int {
+    let p = &mut *(file as *mut ObfsFile);
+    if !p.partner.is_null() {
+        (*p.partner).partner = ptr::null_mut();
+        p.partner = ptr::null_mut();
+    }
+    drop(Box::from_raw(p.cipher));
+    (*p.scratch).fill(0);
+    drop(Box::from_raw(p.scratch));
+    p.key.fill(0);
+    below_call!(file, xClose, ffi::SQLITE_OK)
+}
+
+unsafe extern "C" fn obfs_read(
+    file: *mut ffi::sqlite3_file,
+    buf: *mut c_void,
+    amount: c_int,
+    offset: ffi::sqlite3_int64,
+) -> c_int {
+    let p = &mut *(file as *mut ObfsFile);
+    if p.kind == Kind::Database
+        && !p.in_checkpoint
+        && offset == CHANGE_COUNTER_OFFSET
+        && amount == CHANGE_COUNTER_BYTES
+    {
+        let mut first = [0u8; PAGE_SIZE];
+        let rc = below_call!(file, xRead, ffi::SQLITE_IOERR_READ, first.as_mut_ptr() as *mut c_void, PAGE, 0);
+        let served = rc == ffi::SQLITE_OK && first.starts_with(MAGIC) && open_page(p, &mut first);
+        if served {
+            ptr::copy_nonoverlapping(
+                first.as_ptr().add(CHANGE_COUNTER_OFFSET as usize),
+                buf as *mut u8,
+                CHANGE_COUNTER_BYTES as usize,
+            );
+        }
+        first.fill(0);
+        if served {
+            return ffi::SQLITE_OK;
+        }
+    }
+    let rc = below_call!(file, xRead, ffi::SQLITE_IOERR_READ, buf, amount, offset);
+    if rc == ffi::SQLITE_OK {
+        if (amount == PAGE || amount == PAGE + WAL_FRAME_HEADER_BYTES) && !p.in_checkpoint {
+            let page = slice::from_raw_parts_mut((buf as *mut u8).add((amount - PAGE) as usize), PAGE_SIZE);
+            if open_page(p, page) {
+                p.key_is_its = true;
+            } else if p.kind == Kind::Log && amount == PAGE + WAL_FRAME_HEADER_BYTES && p.key_is_its {
+                // A frame of the log that does not open under a key shown to be its own: one a crash tore, or one
+                // left from an earlier log. SQLite's checksum refuses it as it is, and the log ends there.
+            } else {
+                warn!("obfsvfs: a page does not open under its database's key");
+                return ffi::SQLITE_IOERR_DATA;
+            }
+        }
+    } else if rc == ffi::SQLITE_IOERR_SHORT_READ && p.kind == Kind::Database && offset == 0 && amount >= 100 {
+        ptr::copy_nonoverlapping(EMPTY_HEADER.as_ptr(), buf as *mut u8, EMPTY_HEADER.len());
+        ptr::write_bytes((buf as *mut u8).add(EMPTY_HEADER.len()), 0, amount as usize - EMPTY_HEADER.len());
+        return ffi::SQLITE_OK;
+    }
+    rc
+}
+
+unsafe extern "C" fn obfs_write(
+    file: *mut ffi::sqlite3_file,
+    buf: *const c_void,
+    amount: c_int,
+    offset: ffi::sqlite3_int64,
+) -> c_int {
+    let p = &mut *(file as *mut ObfsFile);
+    let mut data = buf;
+    if amount == PAGE && !p.in_checkpoint {
+        match seal_page(p, slice::from_raw_parts(buf as *const u8, PAGE_SIZE)) {
+            Some(sealed) => data = sealed as *const c_void,
+            None => return ffi::SQLITE_IOERR_WRITE,
+        }
+    } else if amount != PAGE {
+        // Nothing but whole pages goes into a sealed database, and nothing but pages and their headers into its log:
+        // anything else would be written in the clear.
+        let clear = match p.kind {
+            Kind::Database => false,
+            Kind::Log => amount == WAL_HEADER_BYTES || amount == WAL_FRAME_HEADER_BYTES,
+            Kind::Journal => true,
+        };
+        if !clear {
+            warn!("obfsvfs: a write of {amount} bytes into a sealed file is refused");
+            return ffi::SQLITE_IOERR_WRITE;
+        }
+    }
+    below_call!(file, xWrite, ffi::SQLITE_IOERR_WRITE, data, amount, offset)
+}
