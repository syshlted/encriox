+#[cfg(test)]
+mod test {
+    use super::*;
+    use rusqlite::{Connection, ErrorCode, OpenFlags};
+
+    const KEY: [u8; KEY_BYTES] = [7; KEY_BYTES];
+    const OTHER_KEY: [u8; KEY_BYTES] = [9; KEY_BYTES];
+    const MARKER: &str = "ENCRIOXMARKER0123456789abcdef";
+
+    fn flags() -> OpenFlags {
+        OpenFlags::SQLITE_OPEN_URI | OpenFlags::SQLITE_OPEN_READ_WRITE | OpenFlags::SQLITE_OPEN_CREATE
+    }
+
+    fn open_sealed(path: &Path, key: &[u8]) -> rusqlite::Result<Connection> {
+        let conn = Connection::open_with_flags(sealed_name(path, key).unwrap(), flags())?;
+        // As places' own pragmas have it.
+        conn.execute_batch(
+            "PRAGMA page_size = 32768; PRAGMA temp_store = 2; PRAGMA journal_mode = WAL;
+             PRAGMA wal_autocheckpoint = 62;",
+        )?;
+        Ok(conn)
+    }
+
+    fn fill(conn: &Connection, rows: usize) {
+        conn.execute_batch("CREATE TABLE IF NOT EXISTS t (id INTEGER PRIMARY KEY, v TEXT)").unwrap();
+        let tx = conn.unchecked_transaction().unwrap();
+        for i in 0..rows {
+            tx.execute("INSERT INTO t (v) VALUES (?)", [format!("{MARKER}-{i}-{}", "x".repeat(i % 300))])
+                .unwrap();
+        }
+        tx.commit().unwrap();
+    }
+
+    fn count(conn: &Connection) -> rusqlite::Result<i64> {
+        conn.query_row("SELECT count(*) FROM t WHERE v LIKE ?", [format!("{MARKER}%")], |r| r.get(0))
+    }
+
+    fn files(dir: &Path) -> Vec<(PathBuf, Vec<u8>)> {
+        let mut found: Vec<_> = std::fs::read_dir(dir)
+            .unwrap()
+            .map(|e| e.unwrap().path())
+            .map(|p| {
+                let bytes = std::fs::read(&p).unwrap();
+                (p, bytes)
+            })
+            .collect();
+        found.sort();
+        found
+    }
+
+    fn assert_no_marker(dir: &Path) {
+        for (path, bytes) in files(dir) {
+            let found = bytes.windows(MARKER.len()).any(|w| w == MARKER.as_bytes());
+            assert!(!found, "{path:?} holds the marker in the clear");
+        }
+    }
+
+    fn code(e: &rusqlite::Error) -> Option<(ErrorCode, c_int)> {
+        match e {
+            rusqlite::Error::SqliteFailure(f, _) => Some((f.code, f.extended_code)),
+            _ => None,
+        }
+    }
+
+    #[test]
+    fn test_sealed_database_reads_back_and_holds_nothing_in_the_clear() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("places.sqlite");
+        {
+            let conn = open_sealed(&path, &KEY).unwrap();
+            fill(&conn, 2000);
+            assert_eq!(count(&conn).unwrap(), 2000);
+            let page_size: i64 = conn.query_row("PRAGMA page_size", [], |r| r.get(0)).unwrap();
+            assert_eq!(page_size, PAGE_SIZE as i64, "places' page size was taken");
+            assert_no_marker(dir.path());
+        }
+        assert_no_marker(dir.path());
+        let header = std::fs::read(&path).unwrap();
+        assert_eq!(&header[..16], MAGIC);
+        assert_eq!(header[20] as usize, RESERVED_BYTES);
+        let conn = open_sealed(&path, &KEY).unwrap();
+        assert_eq!(count(&conn).unwrap(), 2000);
+    }
+
+    #[test]
+    fn test_log_is_sealed_and_recovered() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("logins.db");
+        let conn = open_sealed(&path, &KEY).unwrap();
+        conn.execute_batch("PRAGMA wal_autocheckpoint = 0").unwrap();
+        fill(&conn, 500);
+        let wal = dir.path().join("logins.db-wal");
+        assert!(std::fs::metadata(&wal).unwrap().len() > 0, "nothing is in the log");
+        assert_no_marker(dir.path());
+        // A second connection while the first holds the log open recovers it from the log alone.
+        let other = open_sealed(&path, &KEY).unwrap();
+        assert_eq!(count(&other).unwrap(), 500);
+        // A copy of the files, as a crash leaves them, recovers from the log.
+        let copy = tempfile::tempdir().unwrap();
+        for (p, bytes) in files(dir.path()) {
+            if !p.to_string_lossy().ends_with("-shm") {
+                std::fs::write(copy.path().join(p.file_name().unwrap()), bytes).unwrap();
+            }
+        }
+        let recovered = open_sealed(&copy.path().join("logins.db"), &KEY).unwrap();
+        assert_eq!(count(&recovered).unwrap(), 500);
+    }
+
+    #[test]
+    fn test_checkpoint_keeps_pages_sealed() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("autofill.db");
+        let conn = open_sealed(&path, &KEY).unwrap();
+        fill(&conn, 1000);
+        conn.execute_batch("PRAGMA wal_checkpoint(TRUNCATE)").unwrap();
+        assert_eq!(std::fs::metadata(dir.path().join("autofill.db-wal")).unwrap().len(), 0);
+        assert!(std::fs::metadata(&path).unwrap().len() > PAGE_SIZE as u64);
+        assert_no_marker(dir.path());
+        drop(conn);
+        let conn = open_sealed(&path, &KEY).unwrap();
+        assert_eq!(count(&conn).unwrap(), 1000);
+        conn.execute_batch("VACUUM").unwrap();
+        assert_eq!(count(&conn).unwrap(), 1000);
+        assert_no_marker(dir.path());
+    }
+
+    #[test]
+    fn test_rollback_journal_is_sealed_and_rolls_back() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("journal.db");
+        let conn = Connection::open_with_flags(sealed_name(&path, &KEY).unwrap(), flags()).unwrap();
+        conn.execute_batch("PRAGMA journal_mode = DELETE; PRAGMA page_size = 32768").unwrap();
+        fill(&conn, 1000);
+        // Outside WAL mode, a VACUUM takes the page size a pragma asked for, unless the pragma was refused.
+        conn.execute_batch("VACUUM").unwrap();
+        let page_size: i64 = conn.query_row("PRAGMA page_size", [], |r| r.get(0)).unwrap();
+        assert_eq!(page_size, PAGE_SIZE as i64);
+        // A cache too small for the change spills it into the database, with the pages it replaces in the journal.
+        conn.execute_batch("PRAGMA cache_size = 2").unwrap();
+        let tx = conn.unchecked_transaction().unwrap();
+        tx.execute("UPDATE t SET v = v || 'changed'", []).unwrap();
+        assert!(dir.path().join("journal.db-journal").exists(), "nothing was journaled");
+        assert_no_marker(dir.path());
+        tx.rollback().unwrap();
+        assert_eq!(count(&conn).unwrap(), 1000);
+        let changed: i64 = conn.query_row("SELECT count(*) FROM t WHERE v LIKE '%changed'", [], |r| r.get(0)).unwrap();
+        assert_eq!(changed, 0);
+        assert_no_marker(dir.path());
+    }
+
+    #[test]
+    fn test_without_its_key_a_sealed_database_is_refused_and_left_as_it_was() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("places.sqlite");
+        {
+            let conn = open_sealed(&path, &KEY).unwrap();
+            conn.execute_batch("PRAGMA wal_autocheckpoint = 0").unwrap();
+            fill(&conn, 300);
+            conn.execute_batch("PRAGMA wal_checkpoint(PASSIVE)").unwrap();
+            fill(&conn, 300);
+            // Left open, so that its log stays, as a lock leaves it.
+            std::mem::forget(conn);
+        }
+        let before = files(dir.path());
+        assert!(ensure_registered());
+        let e = Connection::open_with_flags(&path, flags())
+            .and_then(|c| c.query_row("SELECT count(*) FROM sqlite_master", [], |r| r.get::<_, i64>(0)))
+            .unwrap_err();
+        assert_eq!(code(&e).unwrap().0, ErrorCode::CannotOpen, "{e}");
+        assert_eq!(files(dir.path()), before, "an open without the key changed a file");
+    }
+
+    // The database and its log, as a new process finds them, copied into a directory of their own.
+    fn copied(from: &Path, names: &[&str]) -> tempfile::TempDir {
+        let copy = tempfile::tempdir().unwrap();
+        for name in names {
+            std::fs::copy(from.join(name), copy.path().join(name)).unwrap();
+        }
+        copy
+    }
+
+    // Where each frame's page is in a log.
+    fn frame_pages(log: &[u8]) -> Vec<usize> {
+        let frame = WAL_FRAME_HEADER_BYTES as usize + PAGE_SIZE;
+        let first = WAL_HEADER_BYTES as usize + WAL_FRAME_HEADER_BYTES as usize;
+        (first..=log.len().saturating_sub(PAGE_SIZE)).step_by(frame).collect()
+    }
+
+    fn is_wrong_key(e: &rusqlite::Error) -> bool {
+        code(e) == Some((ErrorCode::AuthorizationForStatementDenied, ffi::SQLITE_AUTH))
+    }
+
+    fn is_damage(e: &rusqlite::Error) -> bool {
+        code(e) == Some((ErrorCode::SystemIoFailure, ffi::SQLITE_IOERR_DATA))
+    }
+
+    #[test]
+    fn test_every_page_carries_its_key_s_check() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("places.sqlite");
+        let conn = open_sealed(&path, &KEY).unwrap();
+        conn.execute_batch("PRAGMA wal_autocheckpoint = 0").unwrap();
+        fill(&conn, 300);
+        conn.execute_batch("PRAGMA wal_checkpoint(PASSIVE)").unwrap();
+        fill(&conn, 300);
+        let check = check_of(&KEY).unwrap();
+        assert_ne!(check, check_of(&OTHER_KEY).unwrap());
+        assert_ne!(check, [0; CHECK_BYTES]);
+        let db = std::fs::read(&path).unwrap();
+        assert!(db.len() > 2 * PAGE_SIZE);
+        for (i, page) in db.chunks(PAGE_SIZE).enumerate() {
+            assert_eq!(page[CHECK_START..], check, "page {}", i + 1);
+        }
+        let log = std::fs::read(dir.path().join("places.sqlite-wal")).unwrap();
+        let frames = frame_pages(&log);
+        assert!(frames.len() > 2);
+        for (i, at) in frames.into_iter().enumerate() {
+            assert_eq!(log[at + CHECK_START..at + PAGE_SIZE], check, "frame {}", i + 1);
+        }
+    }
+
+    #[test]
+    fn test_under_another_key_a_sealed_database_is_refused_and_left_as_it_was() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("places.sqlite");
+        {
+            let conn = open_sealed(&path, &KEY).unwrap();
+            conn.execute_batch("PRAGMA wal_autocheckpoint = 0").unwrap();
+            fill(&conn, 300);
+            conn.execute_batch("PRAGMA wal_checkpoint(PASSIVE)").unwrap();
+            fill(&conn, 300);
+            std::mem::forget(conn);
+        }
+        let copy = copied(dir.path(), &["places.sqlite", "places.sqlite-wal"]);
+        let path = copy.path().join("places.sqlite");
+        let before = files(copy.path());
+        let e = open_sealed(&path, &OTHER_KEY).and_then(|c| count(&c)).unwrap_err();
+        assert!(is_wrong_key(&e), "{e} {:?}", code(&e));
+        // Nothing opened, not even the log's index.
+        assert_eq!(files(copy.path()), before, "an open under another key changed a file, or made one");
+        let conn = open_sealed(&path, &KEY).unwrap();
+        assert_eq!(count(&conn).unwrap(), 600);
+    }
+
+    // A database whose pages carry no check, as one sealed before the checks would: closed, with no log.
+    fn sealed_before_the_checks(path: &Path, rows: usize) {
+        {
+            let conn = open_sealed(path, &KEY).unwrap();
+            fill(&conn, rows);
+            conn.execute_batch("PRAGMA wal_checkpoint(TRUNCATE)").unwrap();
+        }
+        let mut old = std::fs::read(path).unwrap();
+        for page in old.chunks_mut(PAGE_SIZE) {
+            page[CHECK_START..].fill(0);
+        }
+        std::fs::write(path, old).unwrap();
+    }
+
+    #[test]
+    fn test_under_another_key_a_database_sealed_before_the_checks_is_told_by_its_log() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("places.sqlite");
+        sealed_before_the_checks(&path, 300);
+        let old = std::fs::read(&path).unwrap();
+        {
+            // Written since, into its log alone.
+            let conn = open_sealed(&path, &KEY).unwrap();
+            conn.execute_batch("PRAGMA wal_autocheckpoint = 0").unwrap();
+            fill(&conn, 100);
+            std::mem::forget(conn);
+        }
+        assert_eq!(std::fs::read(&path).unwrap(), old, "a page reached the database");
+        let copy = copied(dir.path(), &["places.sqlite", "places.sqlite-wal"]);
+        let path = copy.path().join("places.sqlite");
+        let before = files(copy.path());
+        let e = open_sealed(&path, &OTHER_KEY).and_then(|c| count(&c)).unwrap_err();
+        assert!(is_wrong_key(&e), "{e} {:?}", code(&e));
+        assert_eq!(files(copy.path()), before);
+        let conn = open_sealed(&path, &KEY).unwrap();
+        assert_eq!(count(&conn).unwrap(), 400);
+    }
+
+    #[test]
+    fn test_a_torn_first_frame_ends_the_log_there() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("places.sqlite");
+        {
+            let conn = open_sealed(&path, &KEY).unwrap();
+            conn.execute_batch("PRAGMA wal_autocheckpoint = 0").unwrap();
+            fill(&conn, 200);
+            conn.execute_batch("PRAGMA wal_checkpoint(TRUNCATE)").unwrap();
+            // The first commit after a checkpoint, whose frames start the log again.
+            fill(&conn, 50);
+            std::mem::forget(conn);
+        }
+        let log = std::fs::read(dir.path().join("places.sqlite-wal")).unwrap();
+        let first = frame_pages(&log)[0];
+        // A write cut short leaves the sectors it never reached as they were, here past the log's end, so zeros; and
+        // a page changed in any other way is torn as surely.
+        for (how, tear) in [("zeroed", 0x00u8), ("changed", 0x5a)] {
+            let mut torn = log.clone();
+            for b in &mut torn[first + PAGE_SIZE / 2..first + PAGE_SIZE] {
+                *b = if tear == 0 { 0 } else { *b ^ tear };
+            }
+            let copy = copied(dir.path(), &["places.sqlite"]);
+            std::fs::write(copy.path().join("places.sqlite-wal"), torn).unwrap();
+            let conn = open_sealed(&copy.path().join("places.sqlite"), &KEY)
+                .unwrap_or_else(|e| panic!("{how}: {e} {:?}", code(&e)));
+            let counted = count(&conn).unwrap_or_else(|e| panic!("{how}: {e} {:?}", code(&e)));
+            assert_eq!(counted, 200, "{how}: not what the database held before the torn commit");
+        }
+    }
+
+    #[test]
+    fn test_a_damaged_page_under_its_key_is_damage_never_the_wrong_key() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("places.sqlite");
+        {
+            let conn = open_sealed(&path, &KEY).unwrap();
+            fill(&conn, 2000);
+            // Closed, with everything in the database and no log.
+            conn.execute_batch("PRAGMA wal_checkpoint(TRUNCATE)").unwrap();
+        }
+        let whole = std::fs::read(&path).unwrap();
+        let pages = whole.len() / PAGE_SIZE;
+        // A page of the table, and page 1 past its clear start: each changed in its sealed payload alone, and page 1
+        // through its check too, which the next page's check then tells.
+        let cases = [
+            ("a page of the table", pages / 2, 1000..1016),
+            ("page 1", 0, 1000..1016),
+            ("page 1 whole", 0, CLEAR_PREFIX_BYTES..PAGE_SIZE),
+        ];
+        for (what, page, bytes) in cases {
+            let mut damaged = whole.clone();
+            for b in &mut damaged[page * PAGE_SIZE + bytes.start..page * PAGE_SIZE + bytes.end] {
+                *b ^= 0xff;
+            }
+            let copy = tempfile::tempdir().unwrap();
+            let path = copy.path().join("places.sqlite");
+            std::fs::write(&path, &damaged).unwrap();
+            let e = open_sealed(&path, &KEY).and_then(|c| count(&c)).unwrap_err();
+            assert!(is_damage(&e), "{what}: {e} {:?}", code(&e));
+            assert_eq!(std::fs::read(&path).unwrap(), damaged, "{what}: the database was changed");
+        }
+    }
+
+    #[test]
+    fn test_a_database_sealed_before_the_checks_opens_as_it_did() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("places.sqlite");
+        sealed_before_the_checks(&path, 300);
+        assert_eq!(count(&open_sealed(&path, &KEY).unwrap()).unwrap(), 300);
+        // Under another key nothing tells, and a page that does not open is an I/O error, as before the checks.
+        let e = open_sealed(&path, &OTHER_KEY).and_then(|c| count(&c)).unwrap_err();
+        assert!(is_damage(&e), "{e} {:?}", code(&e));
+    }
+
+    #[test]
+    fn test_with_a_key_a_database_in_the_clear_is_refused_and_left_as_it_was() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("places.sqlite");
+        {
+            let conn = Connection::open(&path).unwrap();
+            conn.execute_batch("PRAGMA journal_mode = WAL").unwrap();
+            fill(&conn, 10);
+        }
+        let before = files(dir.path());
+        let e = open_sealed(&path, &KEY).and_then(|c| count(&c)).unwrap_err();
+        assert_eq!(code(&e).unwrap().0, ErrorCode::CannotOpen, "{e}");
+        assert_eq!(files(dir.path()), before);
+        let conn = Connection::open(&path).unwrap();
+        assert_eq!(count(&conn).unwrap(), 10);
+    }
+
+    #[test]
+    fn test_a_torn_last_frame_ends_the_log_there() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("places.sqlite");
+        {
+            let conn = open_sealed(&path, &KEY).unwrap();
+            conn.execute_batch("PRAGMA wal_autocheckpoint = 0").unwrap();
+            fill(&conn, 200);
+            conn.execute("INSERT INTO t (v) VALUES ('last')", []).unwrap();
+            std::mem::forget(conn);
+        }
+        let wal = dir.path().join("places.sqlite-wal");
+        let copy = tempfile::tempdir().unwrap();
+        let mut log = std::fs::read(&wal).unwrap();
+        let n = log.len();
+        // The last frame's page, half written.
+        for b in &mut log[n - PAGE_SIZE / 2..] {
+            *b ^= 0x5a;
+        }
+        std::fs::write(copy.path().join("places.sqlite-wal"), log).unwrap();
+        std::fs::copy(&path, copy.path().join("places.sqlite")).unwrap();
+        let conn = open_sealed(&copy.path().join("places.sqlite"), &KEY).unwrap();
+        assert_eq!(count(&conn).unwrap(), 200, "the frames before the torn one were lost");
+        let last: i64 = conn.query_row("SELECT count(*) FROM t WHERE v = 'last'", [], |r| r.get(0)).unwrap();
+        assert_eq!(last, 0);
+    }
+
+    #[test]
+    fn test_key_must_be_whole() {
+        assert!(matches!(sealed_name(Path::new("/tmp/x.db"), &[1; 16]), Err(Error::KeyLength(16))));
+        assert!(matches!(sealed_name(Path::new("x.db"), &KEY), Err(Error::RelativePath(_))));
+        let name = sealed_name(Path::new("/data/a b/places.sqlite"), &KEY).unwrap();
+        let name = name.to_str().unwrap();
+        assert!(name.starts_with("file:///data/a%20b/places.sqlite?vfs=appservices-obfsvfs&sealed="), "{name}");
+    }
+
+    #[test]
+    fn test_a_failed_sealed_open_does_not_tell_the_key() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("places.sqlite");
+        Connection::open(&path).unwrap().execute_batch("CREATE TABLE t (v)").unwrap();
+        // A database in the clear, opened sealed, fails as it opens, when rusqlite puts the name into the message.
+        let e = open_sealed(&path, &[0xab; KEY_BYTES]).unwrap_err().to_string();
+        assert!(e.contains("places.sqlite"), "{e}");
+        assert!(!e.to_lowercase().contains(&"ab".repeat(8)), "the message tells the key: {e}");
+        // A name that hands over a key it was not given is refused.
+        let made_up = format!("file://{}?vfs=appservices-obfsvfs&sealed=999999999", path.display());
+        let e = Connection::open_with_flags(made_up, flags()).unwrap_err();
+        assert_eq!(code(&e).unwrap().0, ErrorCode::CannotOpen, "{e}");
