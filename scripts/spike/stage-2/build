#!/bin/sh
# Builds the stage 2 spike's debug APK (W13): Gecko compiled from a checkout that `fetch` made, then Fenix against that
# GeckoView, with encri-api's client from source.
#
#   scripts/spike/stage-2/build <firefox checkout> [<encri-api checkout>]
#
# The checkout, its objdir and mach's state, with the toolchains it bootstraps, belong on the drive for large builds
# (W7); the state goes beside the checkout unless MOZBUILD_STATE_PATH says otherwise. The APKs are under
# <firefox checkout>/obj-encriox-stage-2/gradle/build/mobile/android/fenix/app/outputs/apk/debug/. Run no other Gradle
# build in the suite at the same time: this one includes encri-api, as the companions' do.
set -eu

here=$(cd "$(dirname "$0")" && pwd)
firefox=$(cd "${1:?usage: build <firefox checkout> [<encri-api checkout>]}" && pwd)
encri_api=$(cd "${2:-$here/../../../../encri-api}" && pwd)
. "$here/../stage-1/versions"

export MOZCONFIG="$here/mozconfig"
export MOZBUILD_STATE_PATH="${MOZBUILD_STATE_PATH:-$(dirname "$firefox")/mozbuild}"
# Stage 1's JDK, SDK and bundletool, under ~/.mozbuild (../stage-1/README.md).
export JAVA_HOME="$HOME/.mozbuild/jdk/$MOZ_JDK"
export ANDROID_HOME="$HOME/.mozbuild/android-sdk-linux"
export ANDROID_BUNDLETOOL_PATH="$HOME/.mozbuild/bundletool.jar"

# Rust, which configure bootstraps only in Mozilla's automation: the toolchain Mozilla's CI builds Android with,
# linux64-rust-android, fetched once for this checkout into mach's state.
mkdir -p "$MOZBUILD_STATE_PATH"
[ -x "$MOZBUILD_STATE_PATH/rustc/bin/rustc" ] ||
    (cd "$MOZBUILD_STATE_PATH" && "$firefox/mach" --no-interactive artifact toolchain --from-build linux64-rust-android)
export PATH="$MOZBUILD_STATE_PATH/rustc/bin:$PATH"

cd "$firefox"
./mach --no-interactive build
# From the root build, where :geckoview is a project, so that Android Components takes this checkout's GeckoView.
./mach --no-interactive gradle --console=plain -Pencri.api.dir="$encri_api" fenix:assembleDebug
