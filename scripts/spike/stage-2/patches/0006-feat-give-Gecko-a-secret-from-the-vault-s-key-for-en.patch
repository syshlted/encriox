+        /**
+         * Locks or unlocks Gecko's profile keys, `lock` or `unlock`, and leaves the vault as it is (stage 2), as
+         * [EncriProfileSecret.follow] does at the vault's lock and as it opens; then logs whether they are unlocked.
+         * On the main thread: a GeckoResult answers on the thread that asked.
+         */
+        private fun profile(
+            context: Context,
+            how: String,
+        ) {
+            val runtime = context.components.core.geckoRuntime
+            val asked =
+                when (how) {
+                    "lock" -> runtime.lockProfile()
+                    "unlock" ->
+                        EncriKey.current?.let { key ->
+                            val secret = EncriProfileSecret.derive(key)
+                            runtime.unlockProfile(secret).also { secret.fill(0) }
+                        }
+                    else -> null
+                }
+            if (asked == null) {
+                Log.i(TAG, "profile $how: not done; it is lock, or unlock with the vault's key held")
+                return
+            }
+            asked.accept(
+                { Log.i(TAG, "profile $how unlocked=$it") },
+                { Log.i(TAG, "profile $how failed: $it") },
+            )
+        }
