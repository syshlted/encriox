--- /dev/null
+++ b/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/encri/EncriProfileSecret.kt
@@ -0,0 +1,126 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.encri
+
+import android.content.Context
+import android.os.SystemClock
+import android.util.Log
+import javax.crypto.Mac
+import javax.crypto.spec.SecretKeySpec
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.runBlocking
+import kotlinx.coroutines.withTimeoutOrNull
+import org.mozilla.fenix.ext.components
+import org.mozilla.geckoview.GeckoRuntime
+
+/**
+ * The secret Gecko keeps the profile's Lockstore keys under (encri-firefox, stage 2's second round): derived from the
+ * browser's own key in the vault, [EncriKey], so that the profile's databases, its HTTP cache and its sites' storage
+ * can be opened only while the vault is open to the browser.
+ *
+ * Gecko asks for it once, at startup, on its own thread ([GeckoRuntime.ProfileSecretDelegate]). This opens the vault
+ * for it, as the gate does but asking the user nothing, and answers with nothing if the vault is locked, has not let
+ * the browser in, or does not answer in time. Then, for as long as the process lives, [follow] locks Gecko's keys
+ * when the vault's key is dropped, at a lock, and unlocks them when it is held again.
+ *
+ * With `--es kek withhold` at the gate, it answers with nothing and never unlocks, whatever the vault does: Gecko's
+ * keys stay locked as a locked vault leaves them, on a phone whose vault can be opened again.
+ */
+class EncriProfileSecret(
+    context: Context,
+) : GeckoRuntime.ProfileSecretDelegate {
+    private val context = context.applicationContext
+
+    override fun onProfileSecret(): ByteArray? {
+        val asked = SystemClock.elapsedRealtime()
+        if (withheld(context)) {
+            Log.i(TAG, "profile secret withheld, as the gate was told")
+            return null
+        }
+        val key = runBlocking { withTimeoutOrNull(WAIT_MILLIS) { openVault(context) } }
+        val after = SystemClock.elapsedRealtime() - asked
+        if (key == null) {
+            Log.i(TAG, "profile secret none after ${after}ms")
+            return null
+        }
+        given = true
+        Log.i(TAG, "profile secret given after ${after}ms")
+        return derive(key)
+    }
+
+    companion object {
+        private const val TAG = EncriDownloadFileWriter.TAG
+        private const val WAIT_MILLIS = 10_000L
+        private const val HMAC = "HmacSHA256"
+
+        // The secret is not the vault's key itself, which seals the logins' and the cards' keys too (W6).
+        private val LABEL = "encriox lockstore profile".toByteArray()
+
+        // The main thread's: a GeckoResult answers on the thread that asked, which needs a Looper.
+        private val following = CoroutineScope(SupervisorJob() + Dispatchers.Main)
+
+        /** Whether Gecko holds its keys unlocked, as far as this process has told it. */
+        @Volatile
+        private var given = false
+
+        fun withheld(context: Context): Boolean = context.components.settings.encrioxKekWithheld
+
+        /** The secret for [key], the vault's key. */
+        fun derive(key: ByteArray): ByteArray = Mac.getInstance(HMAC).run {
+            init(SecretKeySpec(key, HMAC))
+            doFinal(LABEL)
+        }
+
+        private suspend fun openVault(context: Context): ByteArray? {
+            val opening = EncriVault.open(context)
+            if (opening !is EncriVault.Opening.Open) {
+                Log.i(TAG, "profile secret: the vault is not open to the browser: $opening")
+                return null
+            }
+            val holding = EncriKey.open(opening.session)
+            if (holding is EncriKey.Holding.Refused) {
+                Log.i(TAG, "profile secret: the browser's key was refused: ${holding.reason}")
+                return null
+            }
+            return EncriKey.current
+        }
+
+        /**
+         * Locks [runtime]'s profile keys whenever the vault's key is dropped, and unlocks them whenever it is held
+         * again, unless the gate was told to withhold the secret.
+         */
+        fun follow(
+            context: Context,
+            runtime: GeckoRuntime,
+        ) {
+            following.launch {
+                EncriKey.holding.collect { held ->
+                    val key = EncriKey.current
+                    when {
+                        held && key != null && !given && !withheld(context) -> {
+                            given = true
+                            val secret = derive(key)
+                            runtime.unlockProfile(secret).accept(
+                                { Log.i(TAG, "profile unlocked as the vault opened: unlocked=$it") },
+                                { Log.i(TAG, "profile unlock failed as the vault opened: $it") },
+                            )
+                            secret.fill(0)
+                        }
+                        !held && given -> {
+                            given = false
+                            runtime.lockProfile().accept(
+                                { Log.i(TAG, "profile locked as the vault locked: unlocked=$it") },
+                                { Log.i(TAG, "profile lock failed as the vault locked: $it") },
+                            )
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
