 #endif
 
+#ifdef MOZ_WIDGET_ANDROID
+#  include "mozilla/java/GeckoRuntimeWrappers.h"
+#endif
+
 namespace mozilla::security::lockstore {
 
+static LazyLogModule sProfileKekLog("ProfileKek");
+
 Maybe<PrimaryPasswordSync> ChoosePrimaryPasswordSync(
     bool aKekExists, bool aKekUnlocked, FunctionRef<bool()> aTokenHasPassword) {
   if (aKekExists) {
@@ -266,8 +276,154 @@ static bool SyncLockstoreWithPrimaryPassword() {
   }
 }
 
+// What a GeckoView embedder answered when asked for the secret it keeps the
+// profile KEK under.
+enum class EmbedderSecret {
+  // It keeps no profile under a secret of its own.
+  None,
+  // It does, and has none to give this session: for encriox, its vault is
+  // locked, or it was told to withhold it.
+  Withheld,
+  Given,
+};
+
+// encriox's spike (encri-firefox, stage 2): a GeckoView embedder may keep the
+// profile KEK under a secret of its own, as encriox keeps it under a key from
+// its vault, in place of the primary password. GeckoView asks the embedder on
+// this thread, Gecko's, which waits for the answer, so the app's own main
+// thread is never held. The Java copy is wiped once it is copied here as hex,
+// the form lockstore takes a password in.
+static EmbedderSecret TakeEmbedderSecret(nsACString& aHexSecret) {
+#ifdef MOZ_WIDGET_ANDROID
+  auto secret = java::GeckoRuntime::TakeProfileSecret();
+  if (!secret) {
+    return EmbedderSecret::None;
+  }
+  nsTArray<int8_t> bytes = secret->GetElements();
+  java::GeckoRuntime::WipeProfileSecret(secret);
+  if (bytes.IsEmpty()) {
+    return EmbedderSecret::Withheld;
+  }
+  HexEncode(Span(reinterpret_cast<const uint8_t*>(bytes.Elements()),
+                 bytes.Length()),
+            aHexSecret);
+  memset(bytes.Elements(), 0, bytes.Length());
+  return EmbedderSecret::Given;
+#else
+  return EmbedderSecret::None;
+#endif
+}
+
+// Moves every DEK still wrapped under a LocalKey under the profile's password
+// KEK, and drops each LocalKey: a LocalKey's record keeps its key in the clear,
+// beside the DEKs it wraps, so a DEK left under one is readable without the
+// secret. Requires the password KEK unlocked. aMoved counts the wrappings
+// moved.
+static nsresult MoveLocalDeksToProfileKek(LockstoreService* aLockstore,
+                                          uint32_t& aMoved) {
+  aMoved = 0;
+  auto deks = aLockstore->DoListDeks();
+  if (deks.isErr()) {
+    return deks.unwrapErr();
+  }
+  nsTArray<nsCString> locals;
+  for (const auto& dek : deks.inspect()) {
+    auto keks = aLockstore->DoListKeks(dek);
+    if (keks.isErr()) {
+      return keks.unwrapErr();
+    }
+    for (const auto& kek : keks.inspect()) {
+      if (StringBeginsWith(kek, "lockstore::kek::local:"_ns)) {
+        ++aMoved;
+        if (!locals.Contains(kek)) {
+          locals.AppendElement(kek);
+        }
+      }
+    }
+  }
+  for (const auto& local : locals) {
+    nsresult rv = aLockstore->DoMigrateDeks(local, kProfilePasswordKek);
+    NS_ENSURE_SUCCESS(rv, rv);
+    // It wraps nothing now; a record left behind is harmless, so this does not
+    // fail the move.
+    (void)aLockstore->DoDeleteKek(local);
+  }
+  return NS_OK;
+}
+
+// Keeps the profile KEK under the embedder's secret: unlocks it, or makes it
+// the first time and moves every DEK under it. Without a secret, a profile KEK
+// that exists stays locked, and startup carries on: what each store does then
+// is what encriox's spike measures. It never refuses startup, and never deletes
+// a key.
+static void SyncProfileKekWithEmbedder() {
+  nsAutoCString secret;
+  const EmbedderSecret answer = TakeEmbedderSecret(secret);
+  if (answer == EmbedderSecret::None) {
+    return;
+  }
+
+  RefPtr<LockstoreService> lockstore = LockstoreService::GetSingleton();
+  nsCOMPtr<nsISerialEventTarget> queue;
+  if (!lockstore || NS_FAILED(NS_CreateBackgroundTaskQueue(
+                        "LockstoreEmbedder", getter_AddRefs(queue)))) {
+    MOZ_LOG(sProfileKekLog, LogLevel::Error,
+            ("embedder: no lockstore, so the profile KEK is not synced"));
+    memset(secret.BeginWriting(), 0, secret.Length());
+    return;
+  }
+
+  bool existed = false;
+  nsresult rv = NS_OK;
+  uint32_t moved = 0;
+  const TimeStamp started = TimeStamp::Now();
+  nsresult dispatchRv = NS_DispatchAndSpinEventLoopUntilComplete(
+      "LockstoreEmbedder"_ns, queue,
+      NS_NewRunnableFunction("LockstoreEmbedder", [&] {
+        existed = KekExists(lockstore, kProfilePasswordKek);
+        if (answer == EmbedderSecret::Withheld) {
+          return;
+        }
+        if (existed) {
+          rv = lockstore->DoUnlockKek(kProfilePasswordKek, secret,
+                                      kCacheForSession);
+        } else {
+          auto created = lockstore->DoCreateKek("password"_ns, kProfileKekId,
+                                                secret, kCacheForSession);
+          rv = created.isErr() ? created.unwrapErr() : NS_OK;
+        }
+        if (NS_SUCCEEDED(rv)) {
+          rv = MoveLocalDeksToProfileKek(lockstore, moved);
+        }
+      }));
+  memset(secret.BeginWriting(), 0, secret.Length());
+  const double ms = (TimeStamp::Now() - started).ToMilliseconds();
+
+  if (NS_FAILED(dispatchRv)) {
+    MOZ_LOG(sProfileKekLog, LogLevel::Error,
+            ("embedder: the keystore was not asked (0x%" PRIx32 ")",
+             static_cast<uint32_t>(dispatchRv)));
+  } else if (answer == EmbedderSecret::Withheld) {
+    MOZ_LOG(sProfileKekLog, LogLevel::Info,
+            ("embedder: secret withheld; the profile KEK %s",
+             existed ? "stays locked" : "does not exist yet"));
+  } else if (NS_FAILED(rv)) {
+    // NS_ERROR_ABORT is a secret that does not open the KEK: the profile's
+    // keys are out of reach until the right one is given, and kept.
+    MOZ_LOG(sProfileKekLog, LogLevel::Error,
+            ("embedder: the profile KEK was not %s (0x%" PRIx32 ") in %.0f ms",
+             existed ? "unlocked" : "made", static_cast<uint32_t>(rv), ms));
+  } else {
+    MOZ_LOG(sProfileKekLog, LogLevel::Info,
+            ("embedder: the profile KEK was %s in %.0f ms; %u DEK wrappings "
+             "moved from LocalKeys",
+             existed ? "unlocked" : "made", ms, moved));
+  }
+}
+
 bool SyncProfileKekAtStartup() {
   MOZ_ASSERT(NS_IsMainThread());
+  SyncProfileKekWithEmbedder();
   const bool canContinue = SyncLockstoreWithPrimaryPassword();
   Preferences::RegisterCallback(&OnLockstoreUnlockPrefChanged,
                                 "security.lockstore.unlock.enabled"_ns);
