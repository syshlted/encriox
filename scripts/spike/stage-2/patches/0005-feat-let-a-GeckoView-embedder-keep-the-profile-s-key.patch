--- a/mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoRuntime.java
+++ b/mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoRuntime.java
@@ -38,6 +38,7 @@ import java.io.FileNotFoundException;
 import java.lang.annotation.Retention;
 import java.lang.annotation.RetentionPolicy;
 import java.util.ArrayList;
+import java.util.Arrays;
 import java.util.List;
 import java.util.Map;
 import org.mozilla.gecko.Clipboard;
@@ -296,6 +297,82 @@ public final class GeckoRuntime implements Parcelable {
     return sRuntime;
   }
 
+  /**
+   * Where Gecko asks for the secret the profile's Lockstore keys are kept under, in place of a
+   * primary password: encriox's spike keeps them under a key from its vault (encri-firefox, stage
+   * 2). Set with {@link GeckoRuntimeSettings.Builder#profileSecretDelegate}.
+   */
+  public interface ProfileSecretDelegate {
+    /**
+     * Called once, at startup, on Gecko's own thread and before the profile's databases open.
+     * Gecko waits for the answer, so this may block until the secret is held; the app's main
+     * thread is not held meanwhile.
+     *
+     * @return The secret, which Gecko wipes once it has a copy; or null to start with the
+     *     profile's keys locked, if they are already kept under a secret.
+     */
+    @AnyThread
+    @Nullable
+    byte[] onProfileSecret();
+  }
+
+  /**
+   * Asks the embedder for the profile's secret: null if it keeps no profile under one, empty if it
+   * has none to give this session.
+   */
+  @WrapForJNI(calledFrom = "gecko")
+  private static @Nullable byte[] takeProfileSecret() {
+    final GeckoRuntime runtime = sRuntime;
+    final ProfileSecretDelegate delegate =
+        runtime == null || runtime.mSettings == null
+            ? null
+            : runtime.mSettings.getProfileSecretDelegate();
+    if (delegate == null) {
+      return null;
+    }
+    try {
+      final byte[] secret = delegate.onProfileSecret();
+      return secret != null ? secret : new byte[0];
+    } catch (final RuntimeException e) {
+      Log.w(LOGTAG, "The profile secret's delegate failed", e);
+      return new byte[0];
+    }
+  }
+
+  @WrapForJNI(calledFrom = "gecko")
+  private static void wipeProfileSecret(final @NonNull byte[] secret) {
+    Arrays.fill(secret, (byte) 0);
+  }
+
+  /**
+   * Locks the profile's Lockstore keys, as encriox's spike does when its vault locks. What Gecko
+   * has already opened keeps its keys; what opens next waits for {@link #unlockProfile}.
+   *
+   * @return A {@link GeckoResult} with whether the profile's keys are still unlocked.
+   */
+  @AnyThread
+  public @NonNull GeckoResult<Boolean> lockProfile() {
+    return EventDispatcher.getInstance().queryBoolean("GeckoView:Lockstore:Lock");
+  }
+
+  /**
+   * Unlocks the profile's Lockstore keys with the secret {@link ProfileSecretDelegate} gives, as
+   * encriox's spike does when its vault opens after Gecko started without it.
+   *
+   * @param secret The secret, which the caller may wipe once this returns.
+   * @return A {@link GeckoResult} with whether the profile's keys are unlocked.
+   */
+  @AnyThread
+  public @NonNull GeckoResult<Boolean> unlockProfile(final @NonNull byte[] secret) {
+    final StringBuilder hex = new StringBuilder(secret.length * 2);
+    for (final byte b : secret) {
+      hex.append(Character.forDigit((b >> 4) & 0xf, 16)).append(Character.forDigit(b & 0xf, 16));
+    }
+    final GeckoBundle bundle = new GeckoBundle(1);
+    bundle.putString("secret", hex.toString());
+    return EventDispatcher.getInstance().queryBoolean("GeckoView:Lockstore:Unlock", bundle);
+  }
+
   /**
    * Called by mozilla::dom::ClientOpenWindow to retrieve the window id to use for a
