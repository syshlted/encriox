diff --git a/mobile/shared/modules/geckoview/GeckoViewLockstore.sys.mjs b/mobile/shared/modules/geckoview/GeckoViewLockstore.sys.mjs
new file mode 100644
index 0000000000..57a818794b
--- /dev/null
+++ b/mobile/shared/modules/geckoview/GeckoViewLockstore.sys.mjs
@@ -0,0 +1,42 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this file,
+ * You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+import { GeckoViewUtils } from "resource://gre/modules/GeckoViewUtils.sys.mjs";
+
+const { debug } = GeckoViewUtils.initLogging("GeckoViewLockstore");
+
+// The profile KEK an embedder's secret keeps the profile's keys under, made at
+// startup (security/lockstore/ProfileKek.cpp); the primary password's name.
+const PROFILE_KEK = "lockstore::kek::password:profile";
+// Unlocked for the rest of the session; lockstore takes a u64.
+const FOR_THE_SESSION_MS = Number.MAX_SAFE_INTEGER;
+
+// encriox's spike (encri-firefox, stage 2): the embedder locks the profile KEK
+// when its vault locks, and unlocks it when the vault opens again. What Gecko
+// has already opened keeps its keys; only what opens next needs the KEK.
+export const GeckoViewLockstore = {
+  async onEvent(aEvent, aData, aCallback) {
+    debug`onEvent ${aEvent}`;
+    const lockstore = Cc["@mozilla.org/security/lockstore;1"].getService(
+      Ci.nsILockstore
+    );
+    try {
+      switch (aEvent) {
+        case "GeckoView:Lockstore:Lock":
+          await lockstore.lockKek(PROFILE_KEK);
+          break;
+        case "GeckoView:Lockstore:Unlock":
+          await lockstore.unlockKek(
+            PROFILE_KEK,
+            aData.secret,
+            FOR_THE_SESSION_MS
+          );
+          break;
+      }
+      aCallback.onSuccess(lockstore.isKekUnlocked(PROFILE_KEK));
+    } catch (e) {
+      aCallback.onError(`${e}`);
+    }
+  },
+};
