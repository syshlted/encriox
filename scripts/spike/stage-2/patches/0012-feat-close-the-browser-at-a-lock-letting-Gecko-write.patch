 import kotlinx.coroutines.SupervisorJob
@@ -27,8 +29,8 @@ import org.mozilla.geckoview.GeckoRuntime
  * opens the vault for it, and where the vault is locked or has not let the browser in, brings up encri's own screens
  * for the user ([EncriUnlock]). If the vault is still not open once they are done, or does not answer, the browser
  * stops there, before Gecko has opened anything of the profile: it does not start without the vault (the user's word,
- * encriox W15). Then, for as long as the process lives, [follow] locks Gecko's keys when the vault's key is
- * dropped, at a lock, and unlocks them when it is held again.
+ * encriox W15). Then [follow] closes the browser when the vault's key is dropped, at a lock, letting Gecko write
+ * what it holds under its keys first (W17, W20).
  *
  * With `--es kek withhold` at the gate, it answers with nothing and never unlocks, whatever the vault does: Gecko
  * starts with its keys locked, which encriox never does, to measure what Gecko does then (W14).
@@ -65,6 +67,9 @@ class EncriProfileSecret(
         private const val WAIT_MILLIS = 30_000L
         private const val HMAC = "HmacSHA256"
 
+        // How long Gecko has to shut down at a lock before the process is ended anyway.
+        private const val CLOSE_MILLIS = 10_000L
+
         // The secret is not the vault's key itself, which seals the logins' and the cards' keys too (W6).
         private val LABEL = "encriox lockstore profile".toByteArray()
 
@@ -117,8 +122,9 @@ class EncriProfileSecret(
         }
 
         /**
-         * Locks [runtime]'s profile keys whenever the vault's key is dropped, and unlocks them whenever it is held
-         * again, unless the gate was told to withhold the secret.
+         * Closes the browser whenever the vault's key is dropped, at a lock, and unlocks [runtime]'s profile keys
+         * whenever it is held again after Gecko started without them, unless the gate was told to withhold the
+         * secret.
          */
         fun follow(
             context: Context,
@@ -139,14 +145,42 @@ class EncriProfileSecret(
                         }
                         !held && given -> {
                             given = false
-                            runtime.lockProfile().accept(
-                                { Log.i(TAG, "profile locked as the vault locked: unlocked=$it") },
-                                { Log.i(TAG, "profile lock failed as the vault locked: $it") },
-                            )
+                            close(runtime)
                         }
                     }
                 }
             }
         }
+
+        /**
+         * Closes the browser at a lock of the vault (W17): its windows go, and Gecko shuts down while it still holds
+         * the profile's keys, so that what it keeps in memory to write later, a page's first local storage among it,
+         * reaches the disk sealed under them; then the process ends, and every key it held with it, the logins' and
+         * the cards' too. If Gecko has not ended it in [CLOSE_MILLIS], it is ended anyway.
+         */
+        private fun close(runtime: GeckoRuntime) {
+            val asked = SystemClock.elapsedRealtime()
+            Log.i(TAG, "browser closes: the vault locked")
+            EncriUnlock.finishAll()
+            // Android Components' engine throws at a shutdown it did not ask for, to hear of it as a crash.
+            runtime.delegate = GeckoRuntime.Delegate {
+                Log.i(TAG, "browser closed: Gecko shut down in ${SystemClock.elapsedRealtime() - asked}ms")
+                end()
+            }
+            Thread(
+                {
+                    SystemClock.sleep(CLOSE_MILLIS)
+                    Log.i(TAG, "browser closed: Gecko had not shut down in ${CLOSE_MILLIS}ms, so it is ended")
+                    end()
+                },
+                "encriox-close",
+            ).apply { isDaemon = true }.start()
+            runtime.shutdown()
+        }
+
+        private fun end(): Nothing {
+            Process.killProcess(Process.myPid())
+            exitProcess(0)
+        }
     }
 }
