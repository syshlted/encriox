@@ -5,10 +5,12 @@
 package org.mozilla.fenix.encri
 
 import android.content.Context
+import android.os.Process
 import android.os.SystemClock
 import android.util.Log
 import javax.crypto.Mac
 import javax.crypto.spec.SecretKeySpec
