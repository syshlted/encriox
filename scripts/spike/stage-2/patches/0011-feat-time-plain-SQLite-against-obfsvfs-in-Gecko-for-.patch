diff --git a/mobile/shared/modules/geckoview/GeckoViewSQLiteBench.sys.mjs b/mobile/shared/modules/geckoview/GeckoViewSQLiteBench.sys.mjs
new file mode 100644
index 0000000000..2dd3f93564
--- /dev/null
+++ b/mobile/shared/modules/geckoview/GeckoViewSQLiteBench.sys.mjs
@@ -0,0 +1,222 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this file,
+ * You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+import { GeckoViewUtils } from "resource://gre/modules/GeckoViewUtils.sys.mjs";
+
+const { debug } = GeckoViewUtils.initLogging("GeckoViewSQLiteBench");
+
+// encriox's spike (stage 2's third round): what obfsvfs costs
+// against plain SQLite, in this Gecko's own SQLite and mozStorage, on the
+// phone. Each kind of database is made afresh in the same directory, outside
+// the profile so that Lockstore makes no key for it, and the same work is
+// timed on each:
+//
+//   plain     as mozStorage opens a database with encryption off, with its
+//             32 KiB pages;
+//   plain-8k  plain, with obfsvfs's 8 KiB pages, which tells the cost of the
+//             page size from the cost of the cipher;
+//   obfsvfs   through obfsvfs, with a key of its own, as Lockstore keeps the
+//             profile's databases: 8 KiB pages, 32 bytes of each reserved.
+//
+// Each is in WAL mode, with mozStorage's own synchronous setting, which on
+// Android is OFF; the cookie store sets NORMAL, which in WAL mode syncs only at
+// a checkpoint. The kinds go in a different order each round.
+const KINDS = ["plain", "plain-8k", "obfsvfs"];
+const MARKER = "encriox-bench-marker";
+// Prime, and so prime to any table size the gate asks for but its multiples.
+const STRIDE = 7919;
+
+function now() {
+  return ChromeUtils.now();
+}
+
+function hex(bytes) {
+  return Array.from(bytes, b => b.toString(16).padStart(2, "0")).join("");
+}
+
+function open(file, key) {
+  let spec = Services.io.newFileURI(file).spec;
+  if (key) {
+    spec += `?key=${key}`;
+  }
+  const url = Services.io.newURI(spec).QueryInterface(Ci.nsIFileURL);
+  return Services.storage.openDatabaseWithFileURL(url, "encriox-bench");
+}
+
+function value(conn, sql) {
+  const statement = conn.createStatement(sql);
+  try {
+    if (!statement.executeStep()) {
+      throw new Error(`no row: ${sql}`);
+    }
+    return statement.getInt64(0);
+  } finally {
+    statement.finalize();
+  }
+}
+
+function sqliteVersion() {
+  const conn = Services.storage.openSpecialDatabase("memory");
+  try {
+    const statement = conn.createStatement("SELECT sqlite_version()");
+    statement.executeStep();
+    const version = statement.getUTF8String(0);
+    statement.finalize();
+    return version;
+  } finally {
+    conn.close();
+  }
+}
+
+function timed(results, name, work) {
+  const start = now();
+  work();
+  results[name] = Math.round((now() - start) * 10) / 10;
+}
+
+function remove(file) {
+  for (const suffix of ["", "-wal", "-shm", "-journal"]) {
+    const each = file.parent.clone();
+    each.append(file.leafName + suffix);
+    if (each.exists()) {
+      each.remove(false);
+    }
+  }
+}
+
+// What the file holds: its page size and reserved bytes from the header,
+// which obfsvfs keeps in the clear, and whether the marker is in the clear.
+async function examine(file) {
+  const bytes = await IOUtils.read(file.path);
+  const pageSize = (bytes[16] << 8) | bytes[17];
+  const text = new TextDecoder("latin1").decode(bytes);
+  return {
+    bytes: bytes.length,
+    pageSize: pageSize == 1 ? 65536 : pageSize,
+    reserved: bytes[20],
+    marker: text.includes(MARKER),
+  };
+}
+
+async function run(dir, kind, rows, commits, lookups) {
+  const file = dir.clone();
+  file.append(`${kind}.sqlite`);
+  remove(file);
+  const key =
+    kind == "obfsvfs"
+      ? hex(
+          Cc["@mozilla.org/security/random-generator;1"]
+            .getService(Ci.nsIRandomGenerator)
+            .generateRandomBytes(32)
+        )
+      : null;
+  const ms = {};
+  let conn;
+  timed(ms, "create", () => {
+    conn = open(file, key);
+    if (kind == "plain-8k") {
+      conn.executeSimpleSQL("PRAGMA page_size = 8192");
+    }
+    conn.executeSimpleSQL("PRAGMA journal_mode = WAL");
+    conn.executeSimpleSQL(
+      "CREATE TABLE t (id INTEGER PRIMARY KEY, url TEXT, title TEXT, n INTEGER)"
+    );
+  });
+  // One transaction of many rows, as a page's history or an import writes.
+  timed(ms, "insert", () =>
+    conn.executeSimpleSQL(
+      `WITH RECURSIVE c(x) AS (SELECT 1 UNION ALL SELECT x + 1 FROM c WHERE x < ${rows})
+       INSERT INTO t (url, title, n) SELECT 'https://site' || (x % 997) || '.example/${MARKER}/' || x, hex(randomblob(48)), x FROM c`
+    )
+  );
+  // Many transactions of a row each, as cookies and permissions are written.
+  timed(ms, "commits", () => {
+    for (let i = 0; i < commits; i++) {
+      conn.executeSimpleSQL(
+        `INSERT INTO t (url, title, n) VALUES ('https://one.example/${MARKER}/${i}', hex(randomblob(48)), ${i})`
+      );
+    }
+  });
+  // Rows read by their key, scattered over the table by a stride prime to its
+  // size, most of them from pages not in mozStorage's 2 MiB cache. The
+  // subquery names c.x, or SQLite would run it once.
+  timed(ms, "lookups", () =>
+    value(
+      conn,
+      `WITH RECURSIVE c(x) AS (SELECT 1 UNION ALL SELECT x + 1 FROM c WHERE x < ${lookups})
+       SELECT sum(length((SELECT title FROM t WHERE id = 1 + (c.x * ${STRIDE}) % ${rows}))) FROM c`
+    )
+  );
+  timed(ms, "update", () =>
+    conn.executeSimpleSQL("UPDATE t SET n = n + 1 WHERE id % 5 = 0")
+  );
+  timed(ms, "index", () =>
+    conn.executeSimpleSQL("CREATE INDEX t_url ON t (url)")
+  );
+  timed(ms, "checkpoint", () =>
+    conn.executeSimpleSQL("PRAGMA wal_checkpoint(TRUNCATE)")
+  );
+  const synchronous = value(conn, "PRAGMA synchronous");
+  conn.close();
+  // A new connection, its page cache empty: every page is read through the
+  // VFS, from the system's file cache.
+  timed(ms, "open", () => {
+    conn = open(file, key);
+  });
+  let total;
+  timed(ms, "scan", () => {
+    total = value(
+      conn,
+      "SELECT count(*) + sum(length(title)) + sum(length(url)) + sum(n) FROM t"
+    );
+  });
+  conn.close();
+  const kept = await examine(file);
+  remove(file);
+  return { kind, ms, total, synchronous, file: kept };
+}
+
+export const GeckoViewSQLiteBench = {
+  async onEvent(aEvent, aData, aCallback) {
+    debug`onEvent ${aEvent}`;
+    try {
+      const rows = aData.rows || 50000;
+      const commits = aData.commits || 500;
+      const lookups = aData.lookups || rows;
+      const rounds = aData.rounds || 5;
+      const dir = Services.dirsvc.get("TmpD", Ci.nsIFile);
+      dir.append("encriox-bench");
+      const profile = Services.dirsvc.get("ProfD", Ci.nsIFile);
+      if (profile.contains(dir) || dir.contains(profile)) {
+        throw new Error(`${dir.path} is in the profile, ${profile.path}`);
+      }
+      if (!dir.exists()) {
+        dir.create(Ci.nsIFile.DIRECTORY_TYPE, 0o700);
+      }
+      const runs = [];
+      for (let round = 0; round < rounds; round++) {
+        const order = KINDS.map((_, i) => KINDS[(i + round) % KINDS.length]);
+        for (const kind of order) {
+          const result = await run(dir, kind, rows, commits, lookups);
+          result.round = round;
+          runs.push(result);
+        }
+      }
+      dir.remove(true);
+      aCallback.onSuccess(
+        JSON.stringify({
+          dir: dir.path,
+          sqlite: sqliteVersion(),
+          rows,
+          commits,
+          lookups,
+          rounds,
+          runs,
+        })
+      );
+    } catch (e) {
+      aCallback.onError(`${e} at ${e.stack?.split("\n")[0]}`);
+    }
+  },
+};
