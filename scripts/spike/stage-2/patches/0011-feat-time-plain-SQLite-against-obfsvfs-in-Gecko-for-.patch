+        /**
+         * Has Gecko time the same work on plain SQLite and through obfsvfs (GeckoViewSQLiteBench), and logs its answer,
+         * a run to a line: logcat cuts a line at about 4 KB. On the main thread: a GeckoResult answers on the thread
+         * that asked.
+         */
+        private fun sqlBench(
+            rows: Int,
+            rounds: Int,
+        ) {
+            val asked =
+                GeckoBundle(2).apply {
+                    if (rows > 0) putInt("rows", rows)
+                    if (rounds > 0) putInt("rounds", rounds)
+                }
+            Log.i(TAG, "sqlbench asked rows=$rows rounds=$rounds")
+            EventDispatcher.getInstance().queryString("GeckoView:SQLite:Bench", asked).accept(
+                { answer ->
+                    val result = JSONObject(answer.orEmpty())
+                    val runs = result.getJSONArray("runs")
+                    result.remove("runs")
+                    for (i in 0 until runs.length()) {
+                        val run = runs.getJSONObject(i)
+                        // Every run carries the bench's own facts, the SQLite it ran on among them.
+                        result.keys().forEach { run.put(it, result.get(it)) }
+                        Log.i(TAG, "sqlbench run $run")
+                    }
+                    Log.i(TAG, "sqlbench done")
+                },
+                // Gecko's own error is the query's data, not its message.
+                { Log.i(TAG, "sqlbench failed: ${(it as? EventDispatcher.QueryException)?.data ?: it}") },
+            )
+        }
