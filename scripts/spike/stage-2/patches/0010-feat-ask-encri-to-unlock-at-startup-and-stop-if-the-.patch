+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.encri
+
+import android.app.Activity
+import android.app.Application
+import android.content.Context
+import android.content.Intent
+import android.os.Bundle
+import android.os.Handler
+import android.os.Looper
+import android.os.Process
+import android.util.Log
+import java.lang.ref.WeakReference
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.TimeUnit
+import kotlin.system.exitProcess
+import kotlinx.coroutines.CompletableDeferred
+
+/**
+ * Brings up encri's own screens when the browser needs the vault open and it is not: the one that lets the browser in,
+ * and the one that unlocks the vault (encriox, stage 2). Gecko's startup asks, through [EncriProfileSecret], and
+ * so does the gate; one request is shown at a time, and every caller waits on the same answer.
+ *
+ * The screens are started from whichever of the browser's activities is in the foreground, or from the next one to
+ * come there: Android lets an app start an activity from the background only on its old releases.
+ */
+object EncriUnlock {
+    private const val TAG = EncriDownloadFileWriter.TAG
+    private const val FINISH_MILLIS = 2000L
+
+    private val main = Handler(Looper.getMainLooper())
+    private val live = mutableListOf<WeakReference<Activity>>()
+    private var resumed: WeakReference<Activity>? = null
+    private var installed = false
+    private var waitingForForeground = false
+    private var pending: CompletableDeferred<Boolean>? = null
+
+    /** Follows the browser's activities, from the application's start: there is one to start the screens from. */
+    @Synchronized
+    fun install(context: Context) {
+        if (installed) return
+        installed = true
+        (context.applicationContext as Application).registerActivityLifecycleCallbacks(Follower)
+    }
+
+    /**
+     * Asks encri to let the browser in and to unlock the vault, as each is needed, and waits for the answer: whether
+     * the vault is open to the browser once encri's screens are done.
+     */
+    suspend fun ask(context: Context): Boolean {
+        install(context)
+        val request =
+            synchronized(this) {
+                pending ?: CompletableDeferred<Boolean>().also {
+                    pending = it
+                    main.post { show() }
+                }
+            }
+        return request.await()
+    }
+
+    /** What [EncriUnlockActivity] found once encri's screens were done. */
+    @Synchronized
+    internal fun answer(open: Boolean) {
+        pending?.complete(open)
+        pending = null
+    }
+
+    /**
+     * Ends the browser without going on: every activity is finished and taken out of the recent apps, then the process
+     * ends, Gecko with it, before it has opened anything of the profile. For a start the vault did not open to.
+     */
+    fun stop(): Nothing {
+        Log.i(TAG, "browser stops: the vault is not open to it")
+        val finished = CountDownLatch(1)
+        main.post {
+            synchronized(this) { live.mapNotNull { it.get() } }.forEach { it.finishAndRemoveTask() }
+            finished.countDown()
+        }
+        finished.await(FINISH_MILLIS, TimeUnit.MILLISECONDS)
+        Process.killProcess(Process.myPid())
+        exitProcess(1)
+    }
+
+    private fun show() {
+        val from = synchronized(this) { resumed?.get() }
+        if (from == null) {
+            Log.i(TAG, "unlock waits for the browser to come to the foreground")
+            synchronized(this) { waitingForForeground = true }
+            return
+        }
+        Log.i(TAG, "unlock asks encri, from ${from.javaClass.simpleName}")
+        from.startActivity(Intent(from, EncriUnlockActivity::class.java))
+    }
+
+    private object Follower : Application.ActivityLifecycleCallbacks {
+        override fun onActivityCreated(
+            activity: Activity,
+            savedInstanceState: Bundle?,
+        ) {
+            synchronized(EncriUnlock) { live.add(WeakReference(activity)) }
+        }
+
+        override fun onActivityResumed(activity: Activity) {
+            val show =
+                synchronized(EncriUnlock) {
+                    resumed = WeakReference(activity)
+                    (waitingForForeground && activity !is EncriUnlockActivity).also {
+                        if (it) waitingForForeground = false
+                    }
+                }
+            if (show) show()
+        }
+
+        override fun onActivityPaused(activity: Activity) {
+            synchronized(EncriUnlock) { if (resumed?.get() === activity) resumed = null }
+        }
+
+        override fun onActivityDestroyed(activity: Activity) {
+            synchronized(EncriUnlock) { live.removeAll { it.get() == null || it.get() === activity } }
+        }
+
+        override fun onActivityStarted(activity: Activity) = Unit
+
+        override fun onActivityStopped(activity: Activity) = Unit
+
+        override fun onActivitySaveInstanceState(
+            activity: Activity,
+            outState: Bundle,
+        ) = Unit
+    }
+}
