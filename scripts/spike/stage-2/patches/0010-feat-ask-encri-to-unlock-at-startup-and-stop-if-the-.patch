+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.encri
+
+import android.os.Bundle
+import android.util.Log
+import androidx.activity.ComponentActivity
+import androidx.activity.result.contract.ActivityResultContracts.StartActivityForResult
+import androidx.lifecycle.lifecycleScope
+import com.systemhalted.encri.client.Encri
+import kotlinx.coroutines.launch
+
+/**
+ * Shows encri's own screens for [EncriUnlock]: the one that lets the browser in, if it is not, then the one that
+ * unlocks the vault, if it is locked, each once. It draws nothing of its own, and answers whether the vault is open to
+ * the browser when they are done; one that ends before then answers that it is not.
+ */
+class EncriUnlockActivity : ComponentActivity() {
+    private val asked = mutableSetOf<String>()
+    private var answered = false
+    private val ask = registerForActivityResult(StartActivityForResult()) { lifecycleScope.launch { proceed() } }
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        // Made again after a change of configuration, the screen it asked for answers to the result above.
+        if (savedInstanceState == null) lifecycleScope.launch { proceed() }
+    }
+
+    private suspend fun proceed() {
+        when (val opening = EncriVault.open(this)) {
+            EncriVault.Opening.NotAuthorized ->
+                if (asked.add(AUTHORIZE)) ask.launch(Encri.authorizationIntent(EncriVault.RIGHTS)) else answer(opening)
+            EncriVault.Opening.Locked ->
+                if (asked.add(UNLOCK)) ask.launch(Encri.unlockIntent()) else answer(opening)
+            else -> answer(opening)
+        }
+    }
+
+    private fun answer(opening: EncriVault.Opening) {
+        val open = opening is EncriVault.Opening.Open
+        Log.i(TAG, "unlock answered open=$open${if (open) "" else ": $opening"}")
+        answered = true
+        EncriUnlock.answer(open)
+        finish()
+    }
+
+    override fun onDestroy() {
+        if (isFinishing && !answered) {
+            Log.i(TAG, "unlock answered open=false: its screen ended first")
+            EncriUnlock.answer(false)
+        }
+        super.onDestroy()
+    }
+
+    private companion object {
+        const val TAG = EncriDownloadFileWriter.TAG
+        const val AUTHORIZE = "authorize"
+        const val UNLOCK = "unlock"
+    }
+}
