#!/bin/sh
# Makes the Firefox checkout the stage 2 spike builds Gecko from (W13): stage 1's, made by its `fetch`, with this
# directory's patches committed on a branch of their own on top of stage 1's.
#
#   scripts/spike/stage-2/fetch <new directory>
#
# Put it on the drive for large builds, /home/coder/extra_space/encri-extraspace (W7): its objdir is tens of GB.
set -eu

here=$(cd "$(dirname "$0")" && pwd)
target=${1:?usage: fetch <new directory>}
. "$here/../stage-1/versions"

"$here/../stage-1/fetch" "$target" >/dev/null
cd "$target"
git switch --quiet -c encriox-spike-stage-2
git am --quiet "$here"/patches/*.patch
git log --oneline "$FIREFOX_COMMIT"..HEAD
