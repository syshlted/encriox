+    // Where each frame's page is in a log.
+    fn frame_pages(log: &[u8]) -> Vec<usize> {
+        let frame = WAL_FRAME_HEADER_BYTES as usize + PAGE_SIZE;
+        let first = WAL_HEADER_BYTES as usize + WAL_FRAME_HEADER_BYTES as usize;
+        (first..=log.len().saturating_sub(PAGE_SIZE)).step_by(frame).collect()
+    }
+
+    fn is_wrong_key(e: &rusqlite::Error) -> bool {
+        code(e) == Some((ErrorCode::AuthorizationForStatementDenied, ffi::SQLITE_AUTH))
+    }
+
+    fn is_damage(e: &rusqlite::Error) -> bool {
+        code(e) == Some((ErrorCode::SystemIoFailure, ffi::SQLITE_IOERR_DATA))
+    }
