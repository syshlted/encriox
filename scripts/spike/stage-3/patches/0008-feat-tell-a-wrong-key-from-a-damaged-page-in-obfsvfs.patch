+/// Whose key a database's pages on disk are sealed under, as its open finds them, before SQLite reads any.
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+enum Verdict {
+    /// Page 1 opens under the key, or a page of the database or of its log carries the key's check.
+    Its,
+    /// None does, and some page carries a check of another key: the wrong key.
+    NotIts,
+    /// No page carries a check, as none did before the checks: a new database, or one sealed before them.
+    Unknown,
+}
+
+/// Reads the database at `path` and its log as they are on disk, for `p`'s key: page 1, then each page's check, the
+/// database's and then the log's, until one is the key's. Under its own key that is page 1 alone; a page 1 damaged,
+/// even through its check, is told by the next.
+unsafe fn judge(p: &mut ObfsFile, path: &CStr) -> Verdict {
+    let Ok(path) = path.to_str() else {
+        return Verdict::Unknown;
+    };
+    let mut other = false;
+    if let Ok(mut file) = std::fs::File::open(path) {
+        let mut first = [0u8; PAGE_SIZE];
+        if file.read_exact(&mut first).is_ok() && first.starts_with(MAGIC) {
+            let opened = open_page(p, &mut first);
+            first.fill(0);
+            if opened {
+                return Verdict::Its;
+            }
+        }
+        match checks(&mut file, 0, PAGE_SIZE as u64, &p.check) {
+            Some(Verdict::Its) => return Verdict::Its,
+            Some(_) => other = true,
+            None => {}
+        }
+    }
+    // The log's frames, which carry the checks where the database's pages do not: one sealed before the checks, and
+    // written since; or one shorter than a page.
+    if let Ok(mut log) = std::fs::File::open(format!("{path}-wal")) {
+        let mut header = [0u8; WAL_HEADER_BYTES as usize];
+        if log.read_exact(&mut header).is_ok()
+            && u32::from_be_bytes([header[0], header[1], header[2], header[3]]) & !1 == WAL_MAGIC
+            && u32::from_be_bytes([header[8], header[9], header[10], header[11]]) as usize == PAGE_SIZE
+        {
+            let first = (WAL_HEADER_BYTES + WAL_FRAME_HEADER_BYTES) as u64;
+            let frame = (WAL_FRAME_HEADER_BYTES + PAGE) as u64;
+            match checks(&mut log, first, frame, &p.check) {
+                Some(Verdict::Its) => return Verdict::Its,
+                Some(_) => other = true,
+                None => {}
+            }
+        }
+    }
+    if other {
+        Verdict::NotIts
+    } else {
+        Verdict::Unknown
+    }
+}
+
+/// The checks of the pages in `file`, the first starting at `first` and each `stride` after the last: Its at the
+/// first that is `check`, NotIts if none is and another is not zero, None if every one is zero, or there are none.
+fn checks(file: &mut std::fs::File, first: u64, stride: u64, check: &[u8; CHECK_BYTES]) -> Option<Verdict> {
+    let mut found = None;
+    let mut at = first + CHECK_START as u64;
+    let mut read = [0u8; CHECK_BYTES];
+    while file.seek(SeekFrom::Start(at)).is_ok() && file.read_exact(&mut read).is_ok() {
+        if read == *check {
+            return Some(Verdict::Its);
+        }
+        if read != [0; CHECK_BYTES] {
+            found = Some(Verdict::NotIts);
+        }
+        at += stride;
+    }
+    found
+}
