+    #[test]
+    fn test_a_torn_first_frame_ends_the_log_there() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("places.sqlite");
+        {
+            let conn = open_sealed(&path, &KEY).unwrap();
+            conn.execute_batch("PRAGMA wal_autocheckpoint = 0").unwrap();
+            fill(&conn, 200);
+            conn.execute_batch("PRAGMA wal_checkpoint(TRUNCATE)").unwrap();
+            // The first commit after a checkpoint, whose frames start the log again.
+            fill(&conn, 50);
+            std::mem::forget(conn);
+        }
+        let log = std::fs::read(dir.path().join("places.sqlite-wal")).unwrap();
+        let first = frame_pages(&log)[0];
+        // A write cut short leaves the sectors it never reached as they were, here past the log's end, so zeros; and
+        // a page changed in any other way is torn as surely.
+        for (how, tear) in [("zeroed", 0x00u8), ("changed", 0x5a)] {
+            let mut torn = log.clone();
+            for b in &mut torn[first + PAGE_SIZE / 2..first + PAGE_SIZE] {
+                *b = if tear == 0 { 0 } else { *b ^ tear };
+            }
+            let copy = copied(dir.path(), &["places.sqlite"]);
+            std::fs::write(copy.path().join("places.sqlite-wal"), torn).unwrap();
+            let conn = open_sealed(&copy.path().join("places.sqlite"), &KEY)
+                .unwrap_or_else(|e| panic!("{how}: {e} {:?}", code(&e)));
+            let counted = count(&conn).unwrap_or_else(|e| panic!("{how}: {e} {:?}", code(&e)));
+            assert_eq!(counted, 200, "{how}: not what the database held before the torn commit");
+        }
+    }
