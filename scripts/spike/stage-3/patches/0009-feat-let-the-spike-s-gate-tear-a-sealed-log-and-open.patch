+        private inline fun <T> withKey(
+            key: ByteArray,
+            use: (ByteArray) -> T,
+        ): T =
+            try {
+                use(key)
+            } finally {
+                key.fill(0)
+            }
+
+        /**
+         * Stage 3's key check, on a sealed places database of the gate's own, [KEYCHECK_NAME] in the cache, under a
+         * key of its own from the vault's: `make` records [visits] visits, a transaction each, and closes it, which
+         * puts them in the database and deletes its log, then [more], which stay in a log while the app is stopped,
+         * as a crash stops it; `read` opens it and logs how many visits it holds, or what the open or the read did.
+         */
+        private suspend fun keycheck(
+            context: Context,
+            how: String,
+            visits: Int,
+            more: Int,
+        ) {
+            val path = File(context.cacheDir, KEYCHECK_NAME)
+            fun Result<*>.said(): String = fold({ it.toString() }, { "failed: $it" })
+            fun record(
+                writer: PlacesWriterConnection,
+                from: Int,
+                count: Int,
+            ) {
+                for (i in from until from + count) {
+                    writer.noteObservation(
+                        VisitObservation(
+                            url = "$SEAL_ORIGIN/keycheck/$i",
+                            title = "Visit $i of the key check",
+                            visitType = PlacesVisitType.LINK,
+                            at = KEYCHECK_START + i,
+                        ),
+                    )
+                }
+            }
+            when (how) {
+                "make" -> {
+                    val made =
+                        runCatching {
+                            context.cacheDir.listFiles { f: File -> f.name.startsWith(KEYCHECK_NAME) }?.forEach {
+                                it.delete()
+                            }
+                            withKey(EncriDatabaseKeys.keycheck()) { key ->
+                                val closed = PlacesApi(path.canonicalPath, key)
+                                val writer = closed.getWriter()
+                                record(writer, 0, visits)
+                                // A writer's own close does nothing while its API is open.
+                                closed.close()
+                                writer.close()
+                                check(!File(path.path + "-wal").exists()) { "its log was not deleted at its close" }
+                                // Held for the process's life: let go, its connection would close at a collection.
+                                keycheckOpen =
+                                    PlacesApi(path.canonicalPath, key).also { record(it.getWriter(), visits, more) }
+                            }
+                            "visits=$visits more=$more"
+                        }
+                    Log.i(TAG, "keycheck made ${made.said()}")
+                }
+                "read" -> {
+                    val read =
+                        runCatching {
+                            withKey(EncriDatabaseKeys.keycheck()) { key ->
+                                PlacesApi(path.canonicalPath, key).also { keycheckOpen = it }
+                            }.getWriter().getVisitInfos(0, Long.MAX_VALUE, emptyList()).size
+                        }
+                    Log.i(TAG, "keycheck read visits=${read.said()}")
+                }
+                else -> Log.i(TAG, "keycheck: no such step: $how")
+            }
+        }
+
