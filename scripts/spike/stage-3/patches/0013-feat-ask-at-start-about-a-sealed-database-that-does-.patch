@@ -0,0 +1,274 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.encri
+
+import android.content.Context
+import android.content.Intent
+import android.util.Log
+import java.io.File
+import java.util.concurrent.ConcurrentHashMap
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Deferred
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.async
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import mozilla.appservices.places.uniffi.SealedDatabaseState
+import mozilla.appservices.places.uniffi.sealedDatabaseCheck
+import mozilla.appservices.places.uniffi.sealedDatabaseRepair
+
+/**
+ * Asks the user what to do with a sealed database that does not open, before its store opens it (encriox W22):
+ * places', which holds the history and the bookmarks, the logins' and autofill's. Each store's key waits here, once a
+ * process, for its database to be read through under it. One that opens, or is not there yet, goes on at once. One
+ * that does not brings up a question, from whichever of the browser's activities is in the foreground, and its store
+ * waits for the answer:
+ *
+ * - damaged, under its own key: repair it, which keeps what SQLite's recovery can still read and loses the rest;
+ *   delete it, and start the store empty; or keep it as it is, and go on without it;
+ * - sealed under another key: kept as it is, and gone on without, never offered for deletion;
+ * - in the clear, which a sealed open refuses: delete it, or keep it.
+ *
+ * Nothing is deleted unasked. A kept database is asked about again at the next start, and its store's opens fail as
+ * they would have, which the store takes as it always has. Sync is off (W17), so the questions say that nothing
+ * deleted or lost comes back.
+ */
+object EncriStores {
+    private const val TAG = EncriDownloadFileWriter.TAG
+
+    /** The three sealed stores, each by its database and its key. */
+    enum class Store(
+        internal val label: String,
+        internal val title: String,
+        internal val subject: String,
+        private val file: (Context) -> File,
+        private val derive: suspend () -> ByteArray,
+    ) {
+        PLACES(
+            "places",
+            "History and bookmarks",
+            "Your history and bookmarks",
+            { File(it.filesDir, "places.sqlite") },
+            EncriDatabaseKeys::places,
+        ),
+        LOGINS(
+            "logins",
+            "Saved logins",
+            "Your saved logins",
+            { it.getDatabasePath("logins2.sqlite") },
+            EncriDatabaseKeys::logins,
+        ),
+        AUTOFILL(
+            "autofill",
+            "Saved cards and addresses",
+            "Your saved cards and addresses",
+            { it.getDatabasePath("autofill.sqlite") },
+            EncriDatabaseKeys::autofill,
+        ),
+        ;
+
+        internal fun path(context: Context): File = file(context)
+
+        internal suspend fun key(): ByteArray = derive()
+    }
+
+    /** An answer to a question, by the label of its button. */
+    enum class Answer(internal val label: String) {
+        REPAIR("Repair"),
+        DELETE("Delete"),
+        KEEP("Keep"),
+        GO_ON("Go on without them"),
+        OK("OK"),
+    }
+
+    /** A question for [EncriStoresActivity]: up to three answers, the first the alert's positive button. */
+    internal class Question(
+        val title: String,
+        val message: String,
+        val answers: List<Answer>,
+    )
+
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.IO)
+    private val decisions = ConcurrentHashMap<Store, Deferred<Unit>>()
+    private val asking = Mutex()
+    private var pending: Pair<Question, CompletableDeferred<Answer>>? = null
+
+    /**
+     * The key [store]'s database is sealed with, once the database is known to open, or the user has said what to do
+     * with it. Its store asks for it when it first opens its database, and waits.
+     */
+    suspend fun key(
+        context: Context,
+        store: Store,
+    ): ByteArray {
+        val app = context.applicationContext
+        // Its own scope's, not the store's: a store's call cancelled mid-question leaves the question to the next. A
+        // decision that failed is not kept: the store's key is asked for again, as it was before there were questions.
+        val decision = decisions.computeIfAbsent(store) { scope.async { decide(app, store) } }
+        try {
+            decision.await()
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            decisions.remove(store, decision)
+            Log.i(TAG, "stores ${store.label} not decided: ${e.message}")
+        }
+        return store.key()
+    }
+
+    /** What the check finds of each store's database, for the gate: nothing is asked, and nothing done. */
+    suspend fun states(context: Context): Map<Store, String> =
+        Store.entries.associateWith { store -> check(context, store)?.name ?: "failed" }
+
+    private suspend fun decide(
+        context: Context,
+        store: Store,
+    ) {
+        val path = store.path(context)
+        val state = check(context, store) ?: return
+        Log.i(TAG, "stores ${store.label} state=$state")
+        var repairFailed: String? = null
+        while (true) {
+            val question = question(store, state, repairFailed) ?: return
+            Log.i(TAG, "stores ${store.label} asks: ${question.answers.joinToString(" ")}")
+            val answer = ask(question)
+            Log.i(TAG, "stores ${store.label} answered=$answer")
+            when (answer) {
+                Answer.DELETE -> {
+                    delete(path)
+                    Log.i(TAG, "stores ${store.label} deleted")
+                    return
+                }
+                Answer.REPAIR -> {
+                    val repaired = withKey(store) { key -> runCatching { sealedDatabaseRepair(path.path, key) } }
+                    repaired.onSuccess { r ->
+                        Log.i(
+                            TAG,
+                            "stores ${store.label} repaired tables=${r.tables} rows=${r.rows} " +
+                                "unreadable=${r.unreadablePages}",
+                        )
+                        ask(
+                            Question(
+                                store.title,
+                                "${store.subject} are repaired: ${r.rows} rows in ${r.tables} tables are kept. " +
+                                    "${r.unreadablePages} of their pages could not be read, and what those held is " +
+                                    "lost.",
+                                listOf(Answer.OK),
+                            ),
+                        )
+                        return
+                    }
+                    repaired.onFailure { e ->
+                        Log.i(TAG, "stores ${store.label} repair failed: ${e.message}")
+                        repairFailed = e.message ?: e.javaClass.simpleName
+                    }
+                }
+                else -> {
+                    Log.i(TAG, "stores ${store.label} kept")
+                    return
+                }
+            }
+        }
+    }
+
+    /** What the check finds of [store]'s database, or null if it could not say: the store then opens it as it would. */
+    private suspend fun check(
+        context: Context,
+        store: Store,
+    ): SealedDatabaseState? =
+        withKey(store) { key ->
+            runCatching { sealedDatabaseCheck(store.path(context).path, key) }
+                .onFailure { Log.i(TAG, "stores ${store.label} check failed: ${it.message}") }
+                .getOrNull()
+        }
+
+    private fun question(
+        store: Store,
+        state: SealedDatabaseState,
+        repairFailed: String?,
+    ): Question? {
+        val gone = "Sync is off, so nothing deleted or lost comes back."
+        return when (state) {
+            SealedDatabaseState.MISSING, SealedDatabaseState.OPENS -> null
+            SealedDatabaseState.DAMAGED ->
+                if (repairFailed == null) {
+                    Question(
+                        store.title,
+                        "${store.subject} do not open: some of their pages are damaged.\n\n" +
+                            "Repair keeps what can still be read, and loses the rest. Delete starts them again " +
+                            "empty. Keep leaves them as they are, and the browser goes on without them, until you " +
+                            "are asked again at the next start.\n\n$gone",
+                        listOf(Answer.REPAIR, Answer.DELETE, Answer.KEEP),
+                    )
+                } else {
+                    Question(
+                        store.title,
+                        "${store.subject} could not be repaired ($repairFailed), and are as they were.\n\n" +
+                            "Delete starts them again empty. Keep leaves them as they are, and the browser goes on " +
+                            "without them, until you are asked again at the next start.\n\n$gone",
+                        listOf(Answer.DELETE, Answer.KEEP),
+                    )
+                }
+            SealedDatabaseState.WRONG_KEY ->
+                Question(
+                    store.title,
+                    "${store.subject} are sealed under a key that is not theirs, so they do not open. They are kept " +
+                        "as they are, never deleted, and the browser goes on without them.",
+                    listOf(Answer.GO_ON),
+                )
+            SealedDatabaseState.IN_THE_CLEAR ->
+                Question(
+                    store.title,
+                    "${store.subject} are stored unencrypted, which the browser does not open.\n\n" +
+                        "Delete starts them again empty. Keep leaves them as they are, and the browser goes on " +
+                        "without them, until you are asked again at the next start.\n\n$gone",
+                    listOf(Answer.DELETE, Answer.KEEP),
+                )
+        }
+    }
+
+    /** Shows [question] once the questions before it are answered, and waits for its answer. */
+    private suspend fun ask(question: Question): Answer =
+        asking.withLock {
+            val answer = CompletableDeferred<Answer>()
+            synchronized(this) { pending = question to answer }
+            EncriUnlock.fromForeground { from -> from.startActivity(Intent(from, EncriStoresActivity::class.java)) }
+            answer.await().also { synchronized(this) { pending = null } }
+        }
+
+    /** The question [EncriStoresActivity] is to show, if one waits. */
+    @Synchronized
+    internal fun question(): Question? = pending?.first
+
+    /** What [EncriStoresActivity] was answered. */
+    @Synchronized
+    internal fun answer(answer: Answer) {
+        pending?.second?.complete(answer)
+    }
+
+    /** A database's files, deleted: it, its log, its log's index, its journal, and a repair a crash left. */
+    private fun delete(path: File) {
+        val suffixes = listOf("", "-wal", "-shm", "-journal")
+        for (suffix in suffixes + suffixes.map { ".repair$it" }) {
+            val file = File(path.path + suffix)
+            if (file.exists() && !file.delete()) Log.i(TAG, "stores could not delete ${file.name}")
+        }
+    }
+
+    private suspend inline fun <T> withKey(
+        store: Store,
+        use: (ByteArray) -> T,
+    ): T {
+        val key = store.key()
+        try {
+            return use(key)
+        } finally {
+            key.fill(0)
+        }
+    }
+}
