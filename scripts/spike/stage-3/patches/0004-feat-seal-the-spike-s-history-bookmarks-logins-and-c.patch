+        private suspend fun seal(
+            context: Context,
+            how: String,
+            marker: String,
+        ) {
+            val core = context.components.core
+            val page = "$SEAL_ORIGIN/places/$marker"
+            val pageTitle = "$marker page"
+            val bookmark = "$SEAL_ORIGIN/bookmark/$marker"
+            val bookmarkTitle = "$marker bookmark"
+            val origin = "https://${marker.lowercase()}.encriox.invalid"
+            fun Result<*>.said(): String = fold({ it.toString() }, { "failed: $it" })
+            when (how) {
+                "write" -> {
+                    val visit =
+                        runCatching {
+                            core.historyStorage.recordVisit(page, PageVisit(VisitType.LINK))
+                            core.historyStorage.recordObservation(page, PageObservation(title = pageTitle))
+                            "recorded"
+                        }
+                    val marked =
+                        runCatching {
+                            core.bookmarksStorage.addItem(BookmarkRoot.Mobile.id, bookmark, bookmarkTitle, null)
+                                .getOrThrow()
+                        }
+                    val login =
+                        runCatching {
+                            val entry =
+                                LoginEntry(
+                                    origin = origin,
+                                    formActionOrigin = origin,
+                                    username = marker,
+                                    password = marker,
+                                )
+                            core.passwordsStorage.add(entry).guid
+                        }
+                    val card =
+                        runCatching {
+                            core.autofillStorage.addCreditCard(
+                                NewCreditCardFields(marker, SEAL_CARD, KEPT_MONTH, KEPT_YEAR, "visa"),
+                            ).guid
+                        }
+                    Log.i(
+                        TAG,
+                        "seal wrote visit=${visit.said()} bookmark=${marked.said()} login=${login.said()} " +
+                            "card=${card.said()}",
+                    )
+                }
+                "read" -> {
+                    val visits =
+                        runCatching {
+                            core.historyStorage.getDetailedVisits(0, Long.MAX_VALUE, emptyList())
+                                .count { it.url == page && it.title == pageTitle }
+                        }
+                    val bookmarks =
+                        runCatching {
+                            core.bookmarksStorage.getBookmarksWithUrl(bookmark).getOrThrow()
+                                .count { it.title == bookmarkTitle }
+                        }
+                    val logins =
+                        runCatching {
+                            core.passwordsStorage.list()
+                                .count { it.origin == origin && it.username == marker && it.password == marker }
+                        }
+                    val cards =
