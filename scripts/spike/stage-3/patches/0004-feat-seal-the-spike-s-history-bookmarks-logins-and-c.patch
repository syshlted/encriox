     /** Waits until the vault has given the browser its key. */
     suspend fun await(): ByteArray = held.filterNotNull().first()
 
+    /**
+     * Runs [block] with the key once the vault has given it, while nothing can drop it: a lock zeroes the key in
+     * place, and what is derived from one zeroed part way would seal a new database under a key never to be had again.
+     */
+    suspend fun <T> withKey(block: (ByteArray) -> T): T {
+        while (true) {
+            await()
+            guard.withLock { held.value?.let { return block(it) } }
+        }
+    }
+
     /**
      * Reads the key from the folder [session]'s grant is rooted at, or makes it there if there is none, and holds it
      * until the vault locks or the session ends.
