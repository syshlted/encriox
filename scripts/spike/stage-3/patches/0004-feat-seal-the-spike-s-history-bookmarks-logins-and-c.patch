@@ -444,6 +611,67 @@ class EncriGateActivity : ComponentActivity() {
          * a run to a line: logcat cuts a line at about 4 KB. On the main thread: a GeckoResult answers on the thread
          * that asked.
          */
+        /**
+         * Times places in the clear and sealed through obfsvfs (stage 3): each round, on two new databases in the
+         * cache, it opens the database, records [visits] visits a transaction each, as browsing does, runs fifty
+         * autocomplete queries, and reads every visit back.
+         */
+        private fun placesBench(
+            context: Context,
+            visits: Int,
+            rounds: Int,
+        ) {
+            Log.i(TAG, "placesbench asked visits=$visits rounds=$rounds")
+            val outcome =
+                runCatching {
+                    for (round in 1..rounds) {
+                        val order = if (round % 2 == 1) listOf(false, true) else listOf(true, false)
+                        for (sealed in order) {
+                            val kind = if (sealed) "sealed" else "plain"
+                            val name = "$PLACES_BENCH_PREFIX$kind-$round.sqlite"
+                            val path = File(context.cacheDir, name)
+                            context.cacheDir.listFiles { f: File -> f.name.startsWith(name) }?.forEach { it.delete() }
+                            val run = JSONObject().put("kind", kind).put("round", round).put("visits", visits)
+                            var at = SystemClock.elapsedRealtime()
+                            fun lap(step: String) {
+                                val now = SystemClock.elapsedRealtime()
+                                run.put("${step}_ms", now - at)
+                                at = now
+                            }
+                            val key = if (sealed) Random.nextBytes(PLACES_BENCH_KEY_BYTES) else null
+                            val api = PlacesApi(path.canonicalPath, key)
+                            lap("open")
+                            val writer = api.getWriter()
+                            val start = System.currentTimeMillis() - visits
+                            for (i in 0 until visits) {
+                                writer.noteObservation(
+                                    VisitObservation(
+                                        url = "https://site${i % PLACES_BENCH_SITES}.example/page/$i",
+                                        title = "Page $i of the benchmark",
+                                        visitType = PlacesVisitType.LINK,
+                                        at = start + i,
+                                    ),
+                                )
+                            }
+                            lap("visits")
+                            val reader = api.openReader()
+                            for (j in 0 until PLACES_BENCH_QUERIES) {
+                                reader.queryAutocomplete("site${j * 7 % PLACES_BENCH_SITES}", PLACES_BENCH_LIMIT)
+                            }
+                            lap("autocomplete")
+                            run.put("read", reader.getVisitInfos(0, Long.MAX_VALUE, emptyList()).size)
+                            lap("scan")
+                            val files = context.cacheDir.listFiles { f: File -> f.name.startsWith(name) }.orEmpty()
+                            run.put("bytes", files.sumOf { it.length() })
+                            api.close()
+                            files.forEach { it.delete() }
+                            Log.i(TAG, "placesbench run $run")
+                        }
+                    }
+                }
+            Log.i(TAG, outcome.fold({ "placesbench done" }, { "placesbench failed: $it" }))
+        }
