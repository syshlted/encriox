+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.encri
+
+import android.os.SystemClock
+import android.util.Log
+import javax.crypto.Mac
+import javax.crypto.spec.SecretKeySpec
+
+/**
+ * The keys application-services' databases are sealed with (encri-firefox, stage 3; `docs/sealed-history.md`):
+ * places', which holds the history and the bookmarks, the logins' and autofill's. Each is an HMAC of the browser's own
+ * key in the vault, [EncriKey], under a label of its own, as Gecko's secret is ([EncriProfileSecret]), and each waits
+ * for that key: none of the three databases is opened before the vault is open to the browser, and a start without
+ * the vault ends before (W15).
+ */
+object EncriDatabaseKeys {
+    private const val TAG = EncriDownloadFileWriter.TAG
+    private const val HMAC = "HmacSHA256"
+
+    /** places.sqlite's: the history and the bookmarks. */
+    suspend fun places(): ByteArray = derive("places")
+
+    /** logins2.sqlite's: each login's origin and times, with its username and password sealed again inside. */
+    suspend fun logins(): ByteArray = derive("logins")
+
+    /** autofill.sqlite's: the cards and the addresses. */
+    suspend fun autofill(): ByteArray = derive("autofill")
+
+    private suspend fun derive(database: String): ByteArray {
+        val asked = SystemClock.elapsedRealtime()
+        val key =
+            EncriKey.withKey { vaultKey ->
+                Mac.getInstance(HMAC).run {
+                    init(SecretKeySpec(vaultKey, HMAC))
+                    doFinal("encriox $database database".toByteArray())
+                }
+            }
+        Log.i(TAG, "database key given: $database after ${SystemClock.elapsedRealtime() - asked}ms")
+        return key
+    }
+}
