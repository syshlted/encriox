new file mode 100644
index 0000000000..3bfeb5c9e9
--- /dev/null
+++ b/third_party/application-services/components/support/sql/src/obfsvfs_cipher.rs
@@ -0,0 +1,102 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+//! obfsvfs's cipher: AES-256-GCM, from the NSS application-services links, with a key imported once for each open
+//! file.
+
+use nss_sys::*;
+use std::os::raw::{c_int, c_uchar, c_uint};
+use std::{mem, ptr};
+
+pub(crate) const NONCE_BYTES: usize = 12;
+pub(crate) const TAG_BYTES: usize = 16;
+
+pub(crate) struct Cipher {
+    key: *mut PK11SymKey,
+}
+
+impl Cipher {
+    pub(crate) fn new(key: &[u8; 32]) -> Option<Self> {
+        nss_as::ensure_initialized();
+        // SAFETY: NSS is initialized, and `item` borrows `key` for the import alone.
+        unsafe {
+            let slot = PK11_GetInternalSlot();
+            if slot.is_null() {
+                return None;
+            }
+            let mut item = SECItem {
+                type_: SECItemType::siBuffer as u32,
+                data: key.as_ptr() as *mut c_uchar,
+                len: key.len() as c_uint,
+            };
+            let imported = PK11_ImportSymKey(
+                slot,
+                CKM_AES_GCM.into(),
+                PK11Origin::PK11_OriginUnwrap as u32,
+                CKA_ENCRYPT.into(),
+                &mut item,
+                ptr::null_mut(),
+            );
+            PK11_FreeSlot(slot);
+            (!imported.is_null()).then_some(Self { key: imported })
+        }
+    }
+
+    fn crypt(&self, encrypt: bool, nonce: &[u8; NONCE_BYTES], input: &[u8], out: &mut [u8], expected: usize) -> bool {
+        let aad: [u8; 0] = [];
+        let mut gcm = CK_GCM_PARAMS {
+            pIv: nonce.as_ptr() as CK_BYTE_PTR,
+            ulIvLen: NONCE_BYTES as CK_ULONG,
+            ulIvBits: (NONCE_BYTES * 8) as CK_ULONG,
+            pAAD: aad.as_ptr() as CK_BYTE_PTR,
+            ulAADLen: 0,
+            ulTagBits: (TAG_BYTES * 8) as CK_ULONG,
+        };
+        let mut params = SECItem {
+            type_: SECItemType::siBuffer as u32,
+            data: &mut gcm as *mut _ as *mut c_uchar,
+            len: mem::size_of::<CK_GCM_PARAMS>() as c_uint,
+        };
+        let mut out_len: c_uint = 0;
+        let f = if encrypt { PK11_Encrypt } else { PK11_Decrypt };
+        // SAFETY: `params` and the buffers outlive the call, and the lengths given are theirs.
+        let rv = unsafe {
+            f(
+                self.key,
+                CKM_AES_GCM.into(),
+                &mut params,
+                out.as_mut_ptr(),
+                &mut out_len,
+                out.len() as c_uint,
+                input.as_ptr(),
+                input.len() as c_uint,
+            )
+        };
+        rv == SECStatus::SECSuccess && out_len as usize == expected
+    }
+
+    /// Seals `data` into `out`, which takes it and the tag after it.
+    pub(crate) fn seal(&self, nonce: &[u8; NONCE_BYTES], data: &[u8], out: &mut [u8]) -> bool {
+        out.len() == data.len() + TAG_BYTES && self.crypt(true, nonce, data, out, data.len() + TAG_BYTES)
+    }
+
+    /// Opens `sealed`, a payload and its tag, into the start of `out`. False if its tag does not match.
+    pub(crate) fn open(&self, nonce: &[u8; NONCE_BYTES], sealed: &[u8], out: &mut [u8]) -> bool {
+        sealed.len() >= TAG_BYTES
+            && out.len() >= sealed.len() - TAG_BYTES
+            && self.crypt(false, nonce, sealed, out, sealed.len() - TAG_BYTES)
+    }
+
+    pub(crate) fn random(buf: &mut [u8]) -> bool {
+        // SAFETY: the length given is the buffer's.
+        unsafe { PK11_GenerateRandom(buf.as_mut_ptr(), buf.len() as c_int) == SECStatus::SECSuccess }
+    }
+}
+
+impl Drop for Cipher {
+    fn drop(&mut self) {
+        // SAFETY: the key was imported in `new`, and is freed once.
+        unsafe { PK11_FreeSymKey(self.key) }
+    }
+}
