+    fn open_sealed(path: &Path, key: &[u8]) -> rusqlite::Result<Connection> {
+        let conn = Connection::open_with_flags(sealed_name(path, key).unwrap(), flags())?;
+        // As places' own pragmas have it.
+        conn.execute_batch(
+            "PRAGMA page_size = 32768; PRAGMA temp_store = 2; PRAGMA journal_mode = WAL;
+             PRAGMA wal_autocheckpoint = 62;",
