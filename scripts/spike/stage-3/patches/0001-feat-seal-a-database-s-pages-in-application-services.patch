+    fn code(e: &rusqlite::Error) -> Option<(ErrorCode, c_int)> {
+        match e {
+            rusqlite::Error::SqliteFailure(f, _) => Some((f.code, f.extended_code)),
+            _ => None,
+        }
+    }
