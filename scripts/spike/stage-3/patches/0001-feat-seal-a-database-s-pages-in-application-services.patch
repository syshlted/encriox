+/// What the start of a database's file says it is.
+enum OnDisk {
+    Missing,
+    Unreadable,
+    /// Too short to say, or not SQLite's: a new database, or one that reads as corrupt either way.
+    Unknown,
+    Clear,
+    Sealed,
+}
+
+fn on_disk(path: &CStr) -> OnDisk {
+    let Ok(path) = path.to_str() else {
+        return OnDisk::Unreadable;
+    };
+    let mut file = match std::fs::File::open(path) {
+        Ok(file) => file,
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => return OnDisk::Missing,
+        Err(_) => return OnDisk::Unreadable,
+    };
+    let mut header = [0u8; 24];
+    match file.read_exact(&mut header) {
+        Ok(()) => {}
+        Err(e) if e.kind() == std::io::ErrorKind::UnexpectedEof => return OnDisk::Unknown,
+        Err(_) => return OnDisk::Unreadable,
+    }
+    if !header.starts_with(MAGIC) {
+        return OnDisk::Unknown;
+    }
+    let page_size = match u16::from_be_bytes([header[16], header[17]]) {
+        1 => 65536,
+        n => n as usize,
+    };
+    if page_size == PAGE_SIZE && header[20] as usize == RESERVED_BYTES {
+        OnDisk::Sealed
+    } else {
+        OnDisk::Clear
+    }
+}
