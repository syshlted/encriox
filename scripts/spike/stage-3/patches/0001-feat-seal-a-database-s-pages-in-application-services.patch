+    fn fill(conn: &Connection, rows: usize) {
+        conn.execute_batch("CREATE TABLE IF NOT EXISTS t (id INTEGER PRIMARY KEY, v TEXT)").unwrap();
+        let tx = conn.unchecked_transaction().unwrap();
+        for i in 0..rows {
+            tx.execute("INSERT INTO t (v) VALUES (?)", [format!("{MARKER}-{i}-{}", "x".repeat(i % 300))])
+                .unwrap();
+        }
+        tx.commit().unwrap();
+    }
