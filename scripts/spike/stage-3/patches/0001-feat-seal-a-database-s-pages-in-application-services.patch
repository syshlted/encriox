+    fn test_key_must_be_whole() {
+        assert!(matches!(sealed_name(Path::new("/tmp/x.db"), &[1; 16]), Err(Error::KeyLength(16))));
+        assert!(matches!(sealed_name(Path::new("x.db"), &KEY), Err(Error::RelativePath(_))));
+        let name = sealed_name(Path::new("/data/a b/places.sqlite"), &KEY).unwrap();
+        let name = name.to_str().unwrap();
+        assert!(name.starts_with("file:///data/a%20b/places.sqlite?vfs=appservices-obfsvfs&key=0707"), "{name}");
+    }
+}
