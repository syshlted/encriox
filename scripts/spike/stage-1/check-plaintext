#!/bin/sh
# Checks that a private session leaves nothing of a page in the spike's data in plaintext (W1, the study's stage 1).
#
#   scripts/spike/stage-1/check-plaintext <adb serial> private|normal
#
# `normal` is the control: the same page in a normal tab must leave its marker on disk, or the check finds nothing
# because it can see nothing. A page from `serve`, reached through `adb reverse`, writes a fresh marker into every
# store a page can reach. Then the app is sent home, so that it saves what it saves, and its whole data directory and
# its external one are copied here and searched for the marker, as ASCII and as UTF-16. Files that appeared or changed
# during the session are listed.
set -eu

here=$(cd "$(dirname "$0")" && pwd)
serial=${1:?usage: check-plaintext <adb serial> private|normal}
mode=${2:?usage: check-plaintext <adb serial> private|normal}
package=com.systemhalted.encri.browser.spike
port=8643
adb="${ADB:-$HOME/Android/Sdk/platform-tools/adb} -s $serial"
marker="ENCRIOX$(od -An -N8 -tx1 /dev/urandom | tr -d ' \n')"
work=$(mktemp -d)
server=
# The server is empty until `serve` starts, and set -u would stop the trap at it before the rest ran.
trap '[ -z "$server" ] || kill "$server" 2>/dev/null || true; $adb reverse --remove tcp:$port 2>/dev/null || true; rm -rf "$work"' EXIT

case $mode in
    private) private=true ;;
    normal) private=false ;;
    *) echo "check-plaintext: the mode is private or normal" >&2; exit 2 ;;
esac

files() {
    $adb shell "run-as $package sh -c 'find . -type f -exec ls -l {} \;'" | awk '{ print $NF, $5 }' | sort
}

$adb push "$here/geckoview-config.yaml" /data/local/tmp/$package-geckoview-config.yaml >/dev/null
$adb shell am force-stop $package
# Not `am start -W`: the gate finishes without drawing, and -W would wait for it forever.
$adb logcat -c
$adb shell am start -n $package/org.mozilla.fenix.encri.EncriGateActivity --es private $private >/dev/null
confirmed=
for _ in $(seq 30); do
    $adb logcat -d -s encriox-spike:I | grep -q "gate private=$private" && confirmed=yes && break
    sleep 1
done
# Unconfirmed, the session would run in whatever mode the last run left, under this run's label.
[ -n "$confirmed" ] || { echo "check-plaintext: the gate did not confirm private=$private" >&2; exit 1; }
$adb shell am force-stop $package
files > "$work/before"

"$here/serve" $port "$marker" > "$work/served" 2>&1 &
server=$!
$adb reverse tcp:$port tcp:$port >/dev/null
sleep 1
# A URL of this run's own, so that no cache answers with an earlier run's page, and history would hold the marker.
$adb shell am start -W -a android.intent.action.VIEW -d "http://127.0.0.1:$port/?run=$marker" \
    -n $package/org.mozilla.fenix.IntentReceiverActivity >/dev/null

stores="cookie localStorage sessionStorage indexedDB cacheAPI serviceWorker httpCache readback"
for _ in $(seq 60); do
    reported=$(grep -c '^report' "$work/served" || true)
    [ "$reported" -ge 8 ] && break
    sleep 1
done
$adb shell input keyevent KEYCODE_HOME
# Gecko writes cookies, local storage and IndexedDB to disk some while after a page does: 10 seconds after the app went
# home, a normal session's were not yet there (the G6, 2026-11-14).
sleep "${SETTLE:-60}"

echo "== $serial, $mode, marker $marker"
for store in $stores; do
    line=$(grep " store=$store\$" "$work/served" | head -1)
    echo "  $store: ${line:-no report}"
done
echo "== files holding the marker, as ASCII or UTF-16"
mkdir "$work/data" "$work/external"
$adb exec-out run-as $package tar -cf - . 2>/dev/null | tar -xf - -C "$work/data" 2>/dev/null || true
$adb pull /sdcard/Android/data/$package "$work/external" >/dev/null 2>&1 || true
python3 -I - "$work" "$marker" <<'SEARCH'
import os, sys
work, marker = sys.argv[1], sys.argv[2]
needles = {"ascii": marker.encode(), "utf-16": marker.encode("utf-16-le")}
for top in ("data", "external"):
    for path, _, names in os.walk(os.path.join(work, top)):
        for name in names:
            if os.path.islink(os.path.join(path, name)):
                continue  # Gecko's profile lock, which points nowhere
            with open(os.path.join(path, name), "rb") as f:
                body = f.read()
            found = [kind for kind, needle in needles.items() if needle in body]
            if found:
                print(f"  {'+'.join(found)}: {top}/{os.path.relpath(os.path.join(path, name), os.path.join(work, top))}")
SEARCH
echo "== files that appeared or changed during the session"
files > "$work/after"
comm -13 "$work/before" "$work/after" | awk '{ print "  " $0 }'
