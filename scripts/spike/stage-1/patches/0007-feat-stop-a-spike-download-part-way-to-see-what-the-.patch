+        /**
+         * Stops a download [after] that many milliseconds, by [how], `pause` or `cancel`, through the broadcast its
+         * notification's button sends; then, if [retry], sends the one *Try again* sends. Each status the download
+         * passes through is logged as it happens.
+         */
+        @Suppress("LongParameterList")
+        private suspend fun stopPartWay(
+            context: Context,
+            id: String,
+            name: String,
+            how: String,
+            after: Long,
+            retry: Boolean,
+        ) {
+            val store = context.components.core.store
+            val watching = work.launch { watch(store, id, name) }
+            delay(after)
+            val action =
+                when (how) {
+                    "cancel" -> AbstractFetchDownloadService.ACTION_CANCEL
+                    else -> AbstractFetchDownloadService.ACTION_PAUSE
+                }
+            send(context, action, id)
+            Log.i(TAG, "fetch sent $how name=$name")
+            // A writer that refuses what it was given waits up to two seconds for encri's reason (encri-api L12).
+            delay(SETTLE_MILLIS)
+            if (retry) {
+                send(context, AbstractFetchDownloadService.ACTION_TRY_AGAIN, id)
+                Log.i(TAG, "fetch sent retry name=$name")
+                awaitStatus(store, id, setOf(Status.DOWNLOADING), SETTLE_MILLIS)
+                awaitStatus(store, id, setOf(Status.COMPLETED, Status.FAILED, Status.CANCELLED), RETRY_MILLIS)
+                delay(SETTLE_MILLIS)
+            }
+            watching.cancel()
+            Log.i(TAG, "fetch settled name=$name status=${store.state.downloads[id]?.status ?: "gone"}")
+        }
+
+        private fun send(
+            context: Context,
+            action: String,
+            id: String,
+        ) = context.sendBroadcast(
+            Intent(action).setPackage(context.packageName).putExtra(INTENT_EXTRA_DOWNLOAD_ID, id),
+        )
+
+        private suspend fun watch(
+            store: BrowserStore,
+            id: String,
+            name: String,
+        ) {
+            var last: String? = null
+            while (true) {
+                val download = store.state.downloads[id]
+                val now = download?.status?.name ?: "gone"
+                if (now != last) {
+                    Log.i(TAG, "fetch status name=$name status=$now copied=${download?.currentBytesCopied}")
+                    last = now
+                }
+                delay(POLL_MILLIS)
+            }
+        }
+
+        private suspend fun awaitStatus(
+            store: BrowserStore,
+            id: String,
+            wanted: Set<Status>,
+            millis: Long,
+        ): Status? =
+            withTimeoutOrNull(millis) {
+                var status = store.state.downloads[id]?.status
+                while (status == null || status !in wanted) {
+                    delay(POLL_MILLIS)
+                    status = store.state.downloads[id]?.status
+                }
+                status
+            }
+
+        /** Logs what the granted folder holds of the bench's and the fetches' writes, by name and size. */
+        private suspend fun list(context: Context) {
+            val opening = EncriVault.open(context)
+            if (opening is EncriVault.Opening.Open) {
+                val session = opening.session
+                when (val listed = session.list(session.grant.scope.id)) {
+                    is EncriResult.Ok ->
+                        listed.value
+                            .filter { it.name.startsWith(BENCH_PREFIX) || it.name.startsWith(FETCH_PREFIX) }
+                            .forEach { Log.i(TAG, "list name=${it.name} bytes=${it.sizeBytes}") }
+                    is EncriResult.Failed -> Log.e(TAG, "list failed: $listed")
+                }
+            }
+            Log.i(TAG, "list done")
+        }
+
         private fun bench(
             context: android.content.Context,
             mib: Int,
