  * Serves `GET /blob?bytes=N&name=…` on the phone's own loopback, so that a measured download runs at the speed of
  * its sink and Gecko's network stack, never at the Wi-Fi's (the stage 1 spike). The bytes are one MiB of seeded noise,
  * repeated, so that nothing on the way can compress them.
+ *
+ * For a download stopped part way: `unsized=true` leaves the length out, so that the body ends when the connection
+ * closes; `rate=<KiB/s>` slows the body down; and a sized blob answers `Range: bytes=N-` with its rest, as a server
+ * that lets a download resume does.
  */
 object LoopbackServer {
     const val PORT = 8642
@@ -45,38 +51,72 @@ object LoopbackServer {
 
     private fun serve(socket: Socket) =
         socket.use {
-            val reader = it.getInputStream().bufferedReader(Charsets.ISO_8859_1)
-            val request = reader.readLine() ?: return@use
-            Log.i(TAG, "loopback request $request")
-            while (reader.readLine()?.isNotEmpty() == true) {
-                // The headers say nothing the answer depends on.
+            try {
+                answer(it)
+            } catch (gone: IOException) {
+                // A download paused or cancelled closes its end. Uncaught on this thread, that would kill the app.
+                Log.i(TAG, "loopback client went away: $gone")
             }
-            val (method, target) = request.split(' ').let { parts -> parts[0] to parts.getOrElse(1) { "/" } }
-            val query = Uri.parse("http://127.0.0.1$target")
-            val size = query.getQueryParameter("bytes")?.toLongOrNull() ?: PATTERN_BYTES.toLong()
-            val name = query.getQueryParameter("name") ?: "encriox-$size.bin"
-            val out = BufferedOutputStream(it.getOutputStream(), BUFFER_BYTES)
-            out.write(
-                (
-                    "HTTP/1.1 200 OK\r\n" +
-                        "Content-Type: application/octet-stream\r\n" +
-                        "Content-Length: $size\r\n" +
-                        "Content-Disposition: attachment; filename=\"$name\"\r\n" +
-                        "Cache-Control: no-store\r\n" +
-                        "Connection: close\r\n\r\n"
-                ).toByteArray(Charsets.ISO_8859_1),
-            )
-            if (method != "HEAD") {
-                var left = size
-                while (left > 0) {
-                    val n = minOf(left, PATTERN_BYTES.toLong()).toInt()
-                    out.write(pattern, 0, n)
-                    left -= n
+        }
+
+    private fun answer(socket: Socket) {
+        val reader = socket.getInputStream().bufferedReader(Charsets.ISO_8859_1)
+        val request = reader.readLine() ?: return
+        Log.i(TAG, "loopback request $request")
+        var from = 0L
+        while (true) {
+            val header = reader.readLine()
+            if (header.isNullOrEmpty()) break
+            if (header.startsWith("Range:", ignoreCase = true)) {
+                from = header.substringAfter("bytes=").substringBefore('-').trim().toLongOrNull() ?: 0L
+                Log.i(TAG, "loopback $header")
+            }
+        }
+        val (method, target) = request.split(' ').let { parts -> parts[0] to parts.getOrElse(1) { "/" } }
+        val query = Uri.parse("http://127.0.0.1$target")
+        val size = query.getQueryParameter("bytes")?.toLongOrNull() ?: PATTERN_BYTES.toLong()
+        val name = query.getQueryParameter("name") ?: "encriox-$size.bin"
+        val unsized = query.getBooleanQueryParameter("unsized", false)
+        val rate = query.getQueryParameter("rate")?.toLongOrNull()?.takeIf { it > 0 }
+        val start = if (!unsized && from in 1 until size) from else 0L
+        val out = BufferedOutputStream(socket.getOutputStream(), BUFFER_BYTES)
+        out.write(
+            buildString {
+                append(if (start > 0) "HTTP/1.1 206 Partial Content\r\n" else "HTTP/1.1 200 OK\r\n")
+                append("Content-Type: application/octet-stream\r\n")
+                if (!unsized) {
+                    append("Content-Length: ${size - start}\r\n")
+                    append("Accept-Ranges: bytes\r\n")
+                }
+                if (start > 0) append("Content-Range: bytes $start-${size - 1}/$size\r\n")
+                append("Content-Disposition: attachment; filename=\"$name\"\r\n")
+                append("Cache-Control: no-store\r\n")
+                append("Connection: close\r\n\r\n")
+            }.toByteArray(Charsets.ISO_8859_1),
+        )
+        if (method != "HEAD") {
+            // Unslowed and from the start, a MiB at a time, as every measured download was served.
+            val piece = if (rate == null) PATTERN_BYTES else BUFFER_BYTES
+            val began = SystemClock.elapsedRealtime()
+            var at = start
+            while (at < size) {
+                val offset = (at % PATTERN_BYTES).toInt()
+                val n = minOf(size - at, piece.toLong(), (PATTERN_BYTES - offset).toLong()).toInt()
+                out.write(pattern, offset, n)
+                at += n
+                if (rate != null) {
+                    out.flush()
+                    val due = (at - start) * MILLIS_PER_SECOND / (rate * KIB)
+                    val early = due - (SystemClock.elapsedRealtime() - began)
+                    if (early > 0) Thread.sleep(early)
                 }
             }
-            out.flush()
-            Log.i(TAG, "loopback served $size bytes for $method")
         }
+        out.flush()
+        Log.i(TAG, "loopback served ${size - start} bytes from $start for $method")
+    }
 
     private const val BACKLOG = 16
+    private const val KIB = 1024L
+    private const val MILLIS_PER_SECOND = 1000L
 }
