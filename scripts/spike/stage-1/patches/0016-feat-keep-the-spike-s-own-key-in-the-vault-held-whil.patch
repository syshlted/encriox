@@ -84,6 +84,14 @@ class EncriGateActivity : ComponentActivity() {
             is EncriVault.Opening.Open -> {
                 val scope = opening.session.grant.scope
                 Log.i(TAG, "gate open scope=${scope.name} id=${scope.id} rights=${opening.session.grant.rights}")
+                val key =
+                    when (val holding = EncriKey.open(opening.session)) {
+                        EncriKey.Holding.Made -> "made"
+                        EncriKey.Holding.Read -> "read"
+                        EncriKey.Holding.AlreadyHeld -> "held"
+                        is EncriKey.Holding.Refused -> "refused: ${holding.reason}"
+                    }
+                Log.i(TAG, "key $key")
