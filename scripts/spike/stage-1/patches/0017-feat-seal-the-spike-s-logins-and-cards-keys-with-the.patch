+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.encri
+
+import android.content.Context
+import android.content.SharedPreferences
+import android.util.Base64
+import java.security.SecureRandom
+import java.util.concurrent.ConcurrentHashMap
+import javax.crypto.Cipher
+import javax.crypto.spec.GCMParameterSpec
+import javax.crypto.spec.SecretKeySpec
+import mozilla.components.lib.dataprotect.KeyValuePreferences
+
+/**
+ * Where the logins' and the cards' own keys are kept (encri-firefox W6): sealed with [EncriKey], the key the vault
+ * holds, in preferences of their own, instead of in Fenix's `SecureAbove22Preferences`, which a release keeps in
+ * plaintext beside the stores.
+ *
+ * Nothing here is read or written before the vault has given the browser its key, and [awaitReady] waits for that.
+ * Without it a read throws, and never answers that nothing is stored: a key manager told its key is gone makes a new
+ * one, and every login the old one sealed is lost. A value once unsealed is kept in memory until the process ends, as
+ * the stores keep the keys they were given.
+ */
+class EncriKeyPreferences(
+    private val context: Context,
+) : KeyValuePreferences {
+    private val prefs: SharedPreferences by lazy { context.getSharedPreferences(NAME, Context.MODE_PRIVATE) }
+    private val unsealed = ConcurrentHashMap<String, String>()
+    private val random = SecureRandom()
+
+    override suspend fun awaitReady() {
+        EncriKey.await()
+    }
+
+    override fun all(): Map<String, String> = prefs.all.keys.associateWith { requireNotNull(getString(it)) }
+
+    override fun getString(key: String): String? {
+        unsealed[key]?.let { return it }
+        // Even that nothing is stored is answered only with the key in hand.
+        browserKey()
+        val sealed = prefs.getString(key, null) ?: return null
+        return open(key, sealed).also { unsealed[key] = it }
+    }
+
+    override fun putString(
+        key: String,
+        value: String,
+    ) {
+        // Committed, not applied: a key lost to a stop a moment later would lose all it sealed (W5, patch 0012).
+        check(prefs.edit().putString(key, seal(key, value)).commit()) { "$key was not saved" }
+        unsealed[key] = value
+    }
+
+    override fun remove(key: String) {
+        check(prefs.edit().remove(key).commit()) { "$key was not removed" }
+        unsealed.remove(key)
+    }
+
+    override fun clear() {
+        check(prefs.edit().clear().commit()) { "the keys were not cleared" }
+        unsealed.clear()
+    }
+
+    private fun browserKey() =
+        EncriKey.current ?: throw IllegalStateException("the vault has not given the browser its key")
+
+    private fun sealingKey() = SecretKeySpec(browserKey(), "AES")
+
+    // AES-256-GCM, a fresh nonce each time, and the value's name as associated data, so a value cannot be moved to
+    // another name.
+    private fun seal(
+        key: String,
+        value: String,
+    ): String {
+        val nonce = ByteArray(NONCE_BYTES).also { random.nextBytes(it) }
+        val cipher = Cipher.getInstance(TRANSFORMATION)
+        cipher.init(Cipher.ENCRYPT_MODE, sealingKey(), GCMParameterSpec(TAG_BITS, nonce))
+        cipher.updateAAD(key.toByteArray())
+        return Base64.encodeToString(nonce + cipher.doFinal(value.toByteArray()), Base64.NO_WRAP)
+    }
+
+    private fun open(
+        key: String,
+        sealed: String,
+    ): String {
+        val bytes = Base64.decode(sealed, Base64.NO_WRAP)
+        val cipher = Cipher.getInstance(TRANSFORMATION)
+        cipher.init(Cipher.DECRYPT_MODE, sealingKey(), GCMParameterSpec(TAG_BITS, bytes, 0, NONCE_BYTES))
+        cipher.updateAAD(key.toByteArray())
+        // A value the key cannot open throws, and is never taken for one that is not there.
+        return String(cipher.doFinal(bytes, NONCE_BYTES, bytes.size - NONCE_BYTES))
+    }
+
+    private companion object {
+        const val NAME = "encriox_keys"
+        const val TRANSFORMATION = "AES/GCM/NoPadding"
+        const val NONCE_BYTES = 12
+        const val TAG_BITS = 128
+    }
+}
