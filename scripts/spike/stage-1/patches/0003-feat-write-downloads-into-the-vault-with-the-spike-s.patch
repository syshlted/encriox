+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.encri
+
+import android.content.Context
+import com.systemhalted.encri.client.ConnectResult
+import com.systemhalted.encri.client.Encri
+import com.systemhalted.encri.client.EncriConnection
+import com.systemhalted.encri.client.EncriSession
+import com.systemhalted.encri.client.Right
+import com.systemhalted.encri.client.SessionOutcome
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+
+/**
+ * The stage 1 spike's way into the vault (encri-firefox W1): one connection and one session, opened on first use and
+ * kept until a request finds it gone. Nothing here asks the user anything; [EncriGateActivity] does.
+ */
+object EncriVault {
+    /** One folder's worth, never the whole vault (the study, *Encri's side*). */
+    val RIGHTS: Set<Right> = setOf(Right.READ, Right.WRITE, Right.CREATE, Right.DELETE)
+
+    private val guard = Mutex()
+    private var connection: EncriConnection? = null
+    private var session: EncriSession? = null
+
+    /** What [open] found. */
+    sealed interface Opening {
+        data class Open(val session: EncriSession) : Opening
+
+        data object NotAuthorized : Opening
+
+        data object Locked : Opening
+
+        data class Refused(val reason: String) : Opening
+    }
+
+    suspend fun open(context: Context): Opening =
+        guard.withLock {
+            val live = connection?.takeIf { it.isConnected }
+            session?.let { if (live != null) return@withLock Opening.Open(it) }
+            val held =
+                live ?: when (val result = Encri.connect(context.applicationContext)) {
+                    is ConnectResult.Connected -> result.connection.also { connection = it }
+                    else -> return@withLock Opening.Refused(result.toString())
+                }
+            when (val outcome = held.openSession()) {
+                is SessionOutcome.Opened -> Opening.Open(outcome.session.also { session = it })
+                SessionOutcome.NotAuthorized -> Opening.NotAuthorized
+                SessionOutcome.Locked -> Opening.Locked
+                else -> Opening.Refused(outcome.toString())
+            }
+        }
+
+    /** Drops the session, so that the next [open] asks encri for a new one. */
+    suspend fun forget() =
+        guard.withLock {
+            session?.close()
+            session = null
+        }
+}
diff --git a/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/encri/LoopbackServer.kt b/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/encri/LoopbackServer.kt
new file mode 100644
index 0000000000..bfa884d6f6
--- /dev/null
+++ b/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/encri/LoopbackServer.kt
@@ -0,0 +1,79 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.encri
+
+import android.net.Uri
+import android.util.Log
+import java.io.BufferedOutputStream
+import java.net.InetAddress
+import java.net.ServerSocket
+import java.net.Socket
+import java.util.concurrent.atomic.AtomicBoolean
+import kotlin.concurrent.thread
+import kotlin.random.Random
+
+/**
+ * Serves `GET /blob?bytes=N&name=…` on the phone's own loopback, so that a measured download runs at the speed of
+ * its sink and Gecko's network stack, never at the Wi-Fi's (the stage 1 spike). The bytes are one MiB of seeded noise,
+ * repeated, so that nothing on the way can compress them.
+ */
+object LoopbackServer {
+    const val PORT = 8642
+    private const val TAG = "encriox-spike"
+    private const val PATTERN_BYTES = 1 shl 20
+    private const val BUFFER_BYTES = 64 * 1024
+    private const val SEED = 20261114
+
+    private val started = AtomicBoolean(false)
+    private val pattern = ByteArray(PATTERN_BYTES).also { Random(SEED).nextBytes(it) }
+
+    fun start() {
+        if (!started.compareAndSet(false, true)) return
+        thread(name = "encriox-loopback", isDaemon = true) {
+            ServerSocket(PORT, BACKLOG, InetAddress.getLoopbackAddress()).use { server ->
+                Log.i(TAG, "loopback server on 127.0.0.1:$PORT")
+                while (true) {
+                    val socket = server.accept()
+                    thread(name = "encriox-loopback-client", isDaemon = true) { serve(socket) }
+                }
+            }
+        }
+    }
+
+    private fun serve(socket: Socket) =
+        socket.use {
+            val reader = it.getInputStream().bufferedReader(Charsets.ISO_8859_1)
+            val request = reader.readLine() ?: return@use
+            while (reader.readLine()?.isNotEmpty() == true) {
+                // The headers say nothing the answer depends on.
+            }
+            val (method, target) = request.split(' ').let { parts -> parts[0] to parts.getOrElse(1) { "/" } }
+            val query = Uri.parse("http://127.0.0.1$target")
+            val size = query.getQueryParameter("bytes")?.toLongOrNull() ?: PATTERN_BYTES.toLong()
+            val name = query.getQueryParameter("name") ?: "encriox-$size.bin"
+            val out = BufferedOutputStream(it.getOutputStream(), BUFFER_BYTES)
+            out.write(
+                (
+                    "HTTP/1.1 200 OK\r\n" +
+                        "Content-Type: application/octet-stream\r\n" +
+                        "Content-Length: $size\r\n" +
+                        "Content-Disposition: attachment; filename=\"$name\"\r\n" +
+                        "Cache-Control: no-store\r\n" +
+                        "Connection: close\r\n\r\n"
+                ).toByteArray(Charsets.ISO_8859_1),
+            )
+            if (method != "HEAD") {
+                var left = size
+                while (left > 0) {
+                    val n = minOf(left, PATTERN_BYTES.toLong()).toInt()
+                    out.write(pattern, 0, n)
+                    left -= n
+                }
+            }
+            out.flush()
+        }
+
+    private const val BACKLOG = 16
