#!/bin/sh
# Measures a download into the vault against one through Fenix's own writer (W1, the study's stage 1).
#
#   scripts/spike/stage-1/measure <adb serial> <MiB> <rounds>
#
# Two measurements, each alternating which sink goes first:
#
# - bench: <MiB> written from memory in 32 KiB pieces, as a download's copy writes them, through each sink. This is
#   the sink alone.
# - fetch: <MiB> downloaded through Fenix's download service and Gecko's network stack from the spike's own server on
#   the phone's loopback, so that the Wi-Fi is not what is measured. One download at a time.
#
# The vault must be open to the spike: run the gate once (README.md) and allow a folder and unlock on encri's screens.
# Prints one line per write: what, sink, MiB, copy seconds, total seconds, MiB/s over the copy.
set -eu

serial=${1:?usage: measure <adb serial> <MiB> <rounds>}
mib=${2:?usage: measure <adb serial> <MiB> <rounds>}
rounds=${3:?usage: measure <adb serial> <MiB> <rounds>}
package=com.systemhalted.encri.browser.spike
gate=$package/org.mozilla.fenix.encri.EncriGateActivity
adb="${ADB:-$HOME/Android/Sdk/platform-tools/adb} -s $serial"

# One logged write as a line: what, sink, MiB, copy seconds, total seconds, MiB/s over the copy.
show() {
    awk -v what="$1" '{
        for (i = 1; i <= NF; i++) { split($i, kv, "="); v[kv[1]] = kv[2] }
        mib = v["bytes"] / 1048576
        printf "%-5s %-7s %6.1f MiB  copy %7.2f s  total %7.2f s  %7.1f MiB/s\n",
            what, v["sink"], mib, v["copy_ms"] / 1000, v["total_ms"] / 1000, mib / (v["copy_ms"] / 1000)
    }'
}

lines() { $adb logcat -d -s encriox-spike:I | grep -c "$1" || true; }

wait_for() {
    pattern=$1 count=$2 seconds=$3
    for _ in $(seq "$seconds"); do
        [ "$(lines "$pattern")" -ge "$count" ] && return 0
        sleep 1
    done
    echo "measure: gave up waiting for '$pattern'" >&2
    $adb logcat -d -s encriox-spike:I AndroidRuntime:E | tail -20 >&2
    exit 1
}

gate() {
    $adb logcat -c
    # Not `am start -W`: the gate finishes without drawing, and -W would wait for it forever.
    $adb shell am start -n $gate "$@" >/dev/null
    wait_for "gate " 1 60
    if [ "$(lines 'gate open')" -lt 1 ]; then
        $adb logcat -d -s encriox-spike:I | grep 'gate ' >&2
        exit 1
    fi
}

gate --ei bench "$mib" --ei rounds "$rounds"
wait_for "bench done" 1 $((rounds * 600))
$adb logcat -d -s encriox-spike:I | grep 'download sink=' | sed 's/^.*download //' | show bench
$adb logcat -d -s encriox-spike:E | grep -A1 'bench sink=.* failed' >&2 || true

round=0
while [ $round -lt "$rounds" ]; do
    if [ $((round % 2)) -eq 0 ]; then order="default encri"; else order="encri default"; fi
    for sink in $order; do
        gate --ei fetch "$mib" --es sink $sink --ei rounds 1
        waited=0
        until [ "$(lines "download sink=$sink")" -ge 1 ]; do
            if $adb logcat -d -s AbstractFetchDownloadService:E | grep -q 'marked as FAILED'; then
                $adb logcat -d -s AbstractFetchDownloadService:E | grep -m 3 -E 'FAILED|Exception|Caused' >&2
                exit 1
            fi
            # A round that never finished is an error, not a line left out of the results.
            [ $waited -lt 600 ] || { echo "measure: gave up waiting for the $sink download of round $round" >&2; exit 1; }
            waited=$((waited + 1))
            sleep 1
        done
        $adb logcat -d -s encriox-spike:I | grep "download sink=$sink" | sed 's/^.*download //' | show fetch
    done
    round=$((round + 1))
done

gate --ez clean true
wait_for "clean removed=" 1 120
